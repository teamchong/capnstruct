<script>
  import {
    defineStruct,
    u8,
    u16,
    u32,
    u64,
    i32,
    f32,
    f64,
    str,
    slice,
    ref,
    fixedArray,
    pack,
    type StructDefLike,
  } from 'capnstruct';
  import { toRustReprC, toGoStruct } from 'capnstruct/codegen';

  // --- SECTION 1: 3 SIDE-BY-SIDE LIVE 60FPS ANIMATIONS (NO TAB SWITCHING) ---
  const Waypoint = defineStruct('Waypoint', {
    lat: f32,
    lon: f32,
  });

  const RadarNode = defineStruct('Flight', {
    id: u32,
    x: f32,
    y: f32,
    alt: u16,
    callsign: str,
    waypoints: slice(Waypoint),
    nextRelay: ref('Flight'),
  });

  const v8Canvas = document.getElementById('cs-anim-v8') as HTMLCanvasElement | null;
  const jscCanvas = document.getElementById('cs-anim-jsc') as HTMLCanvasElement | null;
  const capnCanvas = document.getElementById('cs-anim-capn') as HTMLCanvasElement | null;
  const animCanvases = [v8Canvas, jscCanvas, capnCanvas].filter(Boolean) as HTMLCanvasElement[];

  const swCapnEl = document.getElementById('cs-sw-capn');
  const swRustEl = document.getElementById('cs-sw-rust');
  const swBunEl = document.getElementById('cs-sw-bun');
  const hudMs = document.getElementById('cs-hud-ms');
  const hudHeap = document.getElementById('cs-hud-heap');
  const hintV8 = document.getElementById('cs-hint-v8');
  const hintJsc = document.getElementById('cs-hint-jsc');
  const hintCapn = document.getElementById('cs-hint-capn');
  const selSlider = document.getElementById('cs-sel-slider') as HTMLInputElement | null;
  const selValEl = document.getElementById('cs-sel-val');
  const codeNEl = document.getElementById('cs-code-n');
  const codeAltEl = document.getElementById('cs-code-alt');
  const codeLatEl = document.getElementById('cs-code-lat');
  const codeHitsEl = document.getElementById('cs-code-hits');

  let simScale = 100000;
  let simSelectivityPct = 14;
  let pointerX = 0.52;
  let pointerY = 0.48;
  let lastUserPointerTime = 0;
  let isPointerHovering = false;
  let pulseTimer = 0;

  function triggerCodePulse() {
    codeAltEl?.classList.add('cs-live-pulse');
    codeLatEl?.classList.add('cs-live-pulse');
    if (pulseTimer) window.clearTimeout(pulseTimer);
    pulseTimer = window.setTimeout(() => {
      codeAltEl?.classList.remove('cs-live-pulse');
      codeLatEl?.classList.remove('cs-live-pulse');
    }, 180);
  }
  // Build binary Flight dataset for live 60/120fps zero-copy telemetry simulation
  const MAX_SIM_N = 2500;
  const CALLSIGN_PREFIXES = ['UAL', 'DAL', 'AAL', 'SWA', 'AFR', 'BAW', 'ANA', 'JAL', 'LHX', 'QFA'];
  const simFlatX = new Float32Array(MAX_SIM_N);
  const simFlatY = new Float32Array(MAX_SIM_N);
  const simVelX = new Float32Array(MAX_SIM_N);
  const simVelY = new Float32Array(MAX_SIM_N);
  const simAlt = new Uint16Array(MAX_SIM_N);
  const v8SnapX = new Float32Array(MAX_SIM_N);
  const v8SnapY = new Float32Array(MAX_SIM_N);
  const jscSnapX = new Float32Array(MAX_SIM_N);
  const jscSnapY = new Float32Array(MAX_SIM_N);
  let v8PtrX = pointerX;
  let v8PtrY = pointerY;
  let jscPtrX = pointerX;
  let jscPtrY = pointerY;

  const simPlainRows = Array.from({ length: MAX_SIM_N }, (_, i) => {
    const lane = i % 3;
    const t = ((i * 73) % 1000) / 1000;
    const baseY = lane === 0 ? 0.28 : lane === 1 ? 0.52 : 0.74;
    const wave = Math.sin(t * Math.PI * 2 + lane * 1.4) * 0.11;
    const ny = Math.max(0.12, Math.min(0.88, baseY + wave + (((i * 29) % 100) - 50) * 0.0012));
    const speed = 0.0028 + ((i % 7) * 0.00035);
    const dir = i % 5 === 0 ? -1 : 1;
    const vx = speed * dir;
    const vy = Math.cos(t * Math.PI * 2 + lane) * 0.00035;
    const alt = 28000 + ((i * 400) % 13000);
    simFlatX[i] = v8SnapX[i] = jscSnapX[i] = t;
    simFlatY[i] = v8SnapY[i] = jscSnapY[i] = ny;
    simVelX[i] = vx;
    simVelY[i] = vy;
    simAlt[i] = alt;
    const lat0 = 24.5 + (1 - ny) * 24.5;
    const lon0 = -(124.8 - t * 54.0);
    return RadarNode.item({
      id: 1000 + i,
      x: t,
      y: ny,
      alt,
      callsign: `${CALLSIGN_PREFIXES[i % CALLSIGN_PREFIXES.length]}${100 + (i % 899)}`,
      waypoints: [
        { lat: lat0, lon: lon0 },
        { lat: lat0 + 0.8, lon: lon0 + 2.4 },
      ],
      nextRelay: null,
    });
  });
  const SIM_CLUSTER = 32;
  for (let i = 0; i < 512; i++) {
    const base = Math.floor(i / SIM_CLUSTER) * SIM_CLUSTER;
    simPlainRows[i].nextRelay = simPlainRows[base + ((i + 1) % SIM_CLUSTER)];
  }
  const simCapnBytes = RadarNode.pack(simPlainRows.slice(0, 512));
  const simCapnView = RadarNode.from(simCapnBytes);
  const FLIGHT_STRIDE = simCapnView.stride;

  // Copy button for npm install
  const btnCopyNpm = document.getElementById('cs-btn-copy-npm');
  const npmStatus = document.getElementById('cs-npm-status');
  btnCopyNpm?.addEventListener('click', () => {
    navigator.clipboard?.writeText('npm i capnstruct');
    if (npmStatus) {
      npmStatus.textContent = 'Copied!';
      setTimeout(() => {
        npmStatus.textContent = 'Copy';
      }, 1800);
    }
  });

  // Interactive View Focus Toggle (All 3 vs isolated engine)
  const trioGrid = document.querySelector<HTMLElement>('.cs-trio-grid');
  document.querySelectorAll<HTMLButtonElement>('#cs-focus-group .cs-mini-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#cs-focus-group .cs-mini-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      if (trioGrid) trioGrid.dataset.focus = btn.dataset.focus || 'all';
    });
  });

  function updateStaticLatencyLabels() {
    const scaleFactor = Math.pow(simScale / 25000, 0.65);
    const selFactor = 1 + ((simSelectivityPct - 4) / 96) * 0.35;
    const steadyV8Ms = 14.14 * scaleFactor * selFactor;
    const steadyJscMs = 5.65 * scaleFactor * selFactor;
    const steadyRustMs = 3.68 * scaleFactor * selFactor;
    const steadyCapnMs = 0.17 * scaleFactor * selFactor;
    const steadyWasmMs = 0.07 * scaleFactor * selFactor;
    const minAltFt = Math.round(12000 + ((100 - simSelectivityPct) / 99) * 26000);
    if (codeNEl) codeNEl.textContent = simScale.toLocaleString();
    if (selValEl) selValEl.textContent = `>=${minAltFt.toLocaleString()}ft (${simSelectivityPct}%)`;

    if (hudMs) {
      hudMs.textContent = `${steadyCapnMs.toFixed(2)}ms vs ${steadyRustMs.toFixed(1)}ms (WASM) vs ${steadyV8Ms.toFixed(1)}ms (Clone)`;
    }
    if (hudHeap) {
      hudHeap.textContent = `0.00 MB vs +${(6.87 * scaleFactor).toFixed(1)} MB GC`;
    }
    if (hintV8) {
      hintV8.textContent = `${steadyV8Ms.toFixed(1)} ms clone (Bun: ${steadyJscMs.toFixed(1)} ms) · +${(6.87 * scaleFactor).toFixed(1)} MB GC!`;
    }
    if (hintJsc) {
      hintJsc.textContent = `${steadyRustMs.toFixed(1)} ms WASM / ${(23.0 * scaleFactor).toFixed(1)} ms FFI copy`;
    }
    if (hintCapn) {
      hintCapn.textContent = `${steadyCapnMs.toFixed(2)} ms JS / ${steadyWasmMs.toFixed(2)} ms WASM · 0 MB`;
    }
  }

  document.querySelectorAll<HTMLButtonElement>('#cs-scale-group .cs-mini-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#cs-scale-group .cs-mini-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      simScale = parseInt(btn.dataset.scale || '100000', 10);
      updateStaticLatencyLabels();
      triggerCodePulse();
    });
  });

  if (selSlider) {
    selSlider.addEventListener('input', () => {
      simSelectivityPct = parseInt(selSlider.value || '14', 10);
      updateStaticLatencyLabels();
      triggerCodePulse();
    });
  }
  updateStaticLatencyLabels();

  // Synchronize pointer lens across all 3 animation canvases (plus window-level tracking + smooth autopilot)
  animCanvases.forEach((cvs) => {
    const updatePointer = (clientX: number, clientY: number) => {
      const rect = cvs.getBoundingClientRect();
      if (rect.width <= 0 || rect.height <= 0) return;
      pointerX = Math.max(0.08, Math.min(0.92, (clientX - rect.left) / rect.width));
      pointerY = Math.max(0.12, Math.min(0.88, (clientY - rect.top) / rect.height));
      lastUserPointerTime = performance.now();
      isPointerHovering = true;
      triggerCodePulse();
    };
    cvs.addEventListener('mouseenter', (e) => updatePointer(e.clientX, e.clientY));
    cvs.addEventListener('mousemove', (e) => updatePointer(e.clientX, e.clientY));
    cvs.addEventListener('mouseleave', () => {
      isPointerHovering = false;
      lastUserPointerTime = 0;
    });
    cvs.addEventListener(
      'touchmove',
      (e) => {
        if (e.touches[0]) updatePointer(e.touches[0].clientX, e.touches[0].clientY);
      },
      { passive: true }
    );
    cvs.addEventListener('touchend', () => {
      isPointerHovering = false;
      lastUserPointerTime = 0;
    });
  });
  // DOM Overlay Elements (pointer-events: none live HUD over each canvas)
  const badgeV8El = document.getElementById('cs-badge-v8');
  const inspV8StateEl = document.getElementById('cs-insp-v8-state');
  const inspV8Line1El = document.getElementById('cs-insp-v8-line1');
  const inspV8Line2El = document.getElementById('cs-insp-v8-line2');
  const badgeJscEl = document.getElementById('cs-badge-jsc');
  const inspJscLine1El = document.getElementById('cs-insp-jsc-line1');
  const inspOffEl = document.getElementById('cs-insp-off');
  const inspIdxEl = document.getElementById('cs-insp-idx');
  const inspCallEl = document.getElementById('cs-insp-call');
  const inspCoordsEl = document.getElementById('cs-insp-coords');
  const inspHexEl = document.getElementById('cs-insp-hex');

  interface MultiFramePoint {
    v8Ms: number;
    jscMs: number;
    rustMs: number;
    capnMs: number;
    v8Gc: boolean;
    jscGc: boolean;
  }
  const frameHistory: MultiFramePoint[] = [];
  const MAX_HISTORY = 90;
  let frameTick = 0;

  let v8RadarAngle = 0;
  let jscRadarAngle = 0;
  let capnRadarAngle = 0;
  let v8Prog = 0;
  let jscProg = 0;
  let capnProg = 0;
  let v8Sweeps = 0;
  let jscSweeps = 0;
  let capnSweeps = 0;
  let v8HeapAccum = 0;
  let jscHeapAccum = 0;
  let v8GcStall = 0;
  let jscGcStall = 0;
  let lockedFlightIdx = 42;
  let lockedRing: number[] = [12, 42, 78, 105];

  function renderAnimCard(
    canvas: HTMLCanvasElement | null,
    opts: {
      kind: 'v8' | 'jsc' | 'capn';
      color: string;
      radarAng: number;
      prog: number;
      sweeps: number;
      heapMB: number;
      maxHeapMB: number;
      stalled: boolean;
      memSub: string;
      msLabel: string;
      radius: number;
    }
  ) {
    if (!canvas) return;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const cssW = Math.max(260, Math.round(canvas.clientWidth || 340));
    const cssH = Math.max(240, Math.round(canvas.clientHeight || 280));
    const targetW = Math.round(cssW * dpr);
    const targetH = Math.round(cssH * dpr);
    if (canvas.width !== targetW || canvas.height !== targetH) {
      canvas.width = targetW;
      canvas.height = targetH;
    }
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const w = cssW;
    const h = cssH;

    ctx.fillStyle = '#090d16';
    ctx.fillRect(0, 0, w, h);

    // TOP ZONE (28..126px): Live Airspace Sector + Curved slice(Waypoint) Splines + Cyclic ref('Flight') Mesh
    const radarTop = 28;
    const radarBot = 126;
    const radarH = radarBot - radarTop;

    // Subtle Lat/Lon sector grid
    ctx.strokeStyle = 'rgba(148, 163, 184, 0.07)';
    ctx.lineWidth = 1;
    const stepX = Math.max(44, Math.round(w / 7));
    for (let gx = stepX; gx < w; gx += stepX) {
      ctx.beginPath();
      ctx.moveTo(gx, radarTop);
      ctx.lineTo(gx, radarBot);
      ctx.stroke();
    }
    for (let gy = radarTop + 24; gy < radarBot; gy += 24) {
      ctx.beginPath();
      ctx.moveTo(0, gy);
      ctx.lineTo(w, gy);
      ctx.stroke();
    }

    // Sector airport waypoints
    ctx.font = 'bold 8px ui-monospace, SFMono-Regular, monospace';
    ctx.fillStyle = 'rgba(148, 163, 184, 0.38)';
    ctx.textAlign = 'left';
    ctx.fillText('SFO', 8, radarTop + 14);
    ctx.fillText('LAX', 8, radarBot - 6);
    ctx.textAlign = 'center';
    ctx.fillText('DEN · ORD', w * 0.5, radarTop + 14);
    ctx.textAlign = 'right';
    ctx.fillText('JFK', w - 8, radarTop + 14);
    ctx.fillText('MIA', w - 8, radarBot - 6);
    ctx.textAlign = 'left';

    const activePtrX = opts.kind === 'v8' ? v8PtrX : opts.kind === 'jsc' ? jscPtrX : pointerX;
    const activePtrY = opts.kind === 'v8' ? v8PtrY : opts.kind === 'jsc' ? jscPtrY : pointerY;
    const srcX = opts.kind === 'v8' ? v8SnapX : opts.kind === 'jsc' ? jscSnapX : simFlatX;
    const srcY = opts.kind === 'v8' ? v8SnapY : opts.kind === 'jsc' ? jscSnapY : simFlatY;

    const cx = activePtrX * w;
    const cy = radarTop + Math.min(0.86, Math.max(0.14, activePtrY)) * radarH;
    const radPx = Math.max(28, opts.radius * Math.min(w, radarH * 1.45));
    const r2 = Math.max(0.025, opts.radius * opts.radius * 1.25);

    // Query lens backdrop + rotating radar sweep hand
    ctx.fillStyle =
      opts.kind === 'capn'
        ? 'rgba(16, 185, 129, 0.08)'
        : opts.kind === 'jsc'
          ? 'rgba(168, 85, 247, 0.07)'
          : 'rgba(245, 158, 11, 0.07)';
    ctx.beginPath();
    ctx.arc(cx, cy, radPx, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = opts.color;
    ctx.lineWidth = 1.25;
    ctx.beginPath();
    ctx.arc(cx, cy, radPx, 0, Math.PI * 2);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(cx, cy);
    ctx.lineTo(cx + Math.cos(opts.radarAng) * radPx, cy + Math.sin(opts.radarAng) * radPx);
    ctx.stroke();

    // 1. Outside lens: fast fixed-stride aircraft scan; collect closest aircraft inside lens for cyclic mesh
    const sampleCount = 160;
    const candidates: { idx: number; d2: number; px: number; py: number }[] = [];

    for (let i = 0; i < sampleCount; i++) {
      const nx = srcX[i];
      const ny = srcY[i];
      const dx = nx - activePtrX;
      const dy = ny - activePtrY;
      const d2 = dx * dx + dy * dy;
      const px = nx * w;
      const py = radarTop + ny * radarH;
      if (d2 <= r2 * 1.35) {
        candidates.push({ idx: i, d2, px, py });
      } else {
        ctx.fillStyle = 'rgba(148, 163, 184, 0.34)';
        ctx.fillRect(px - 1, py - 1, 2, 2);
      }
    }

    candidates.sort((a, b) => a.d2 - b.d2);
    const meshNodes = candidates.slice(0, 4);
    if (opts.kind === 'capn' && meshNodes.length >= 3) {
      lockedFlightIdx = meshNodes[0].idx;
      lockedRing = meshNodes.map((m) => m.idx);
    }

    // Draw remaining inside-lens aircraft + curved slice(Waypoint) trajectories for mesh nodes
    for (let k = 4; k < candidates.length; k++) {
      const c = candidates[k];
      ctx.fillStyle = 'rgba(226, 232, 240, 0.65)';
      ctx.fillRect(c.px - 1.4, c.py - 1.4, 2.8, 2.8);
    }

    // 2A. From (B): Render curved waypoints: slice(Waypoint) splines bent around cursor obstacle
    for (let m = 0; m < meshNodes.length; m++) {
      const node = meshNodes[m];
      const dir = simVelX[node.idx] >= 0 ? 1 : -1;
      const wpSpan = 34 * dir;
      // Cursor obstacle bends the waypoint spline smoothly away from (cx, cy)
      const relY = node.py - cy;
      const bendY = (relY >= 0 ? 1 : -1) * Math.max(6, 18 - Math.min(14, Math.abs(relY) * 0.4));
      const w0x = node.px;
      const w0y = node.py;
      const w1x = Math.max(8, Math.min(w - 8, node.px + wpSpan * 0.38));
      const w1y = Math.max(radarTop + 6, Math.min(radarBot - 6, node.py + bendY * 0.65));
      const w2x = Math.max(8, Math.min(w - 8, node.px + wpSpan * 0.75));
      const w2y = Math.max(radarTop + 6, Math.min(radarBot - 6, node.py + bendY));
      const w3x = Math.max(8, Math.min(w - 8, node.px + wpSpan * 1.1));
      const w3y = Math.max(radarTop + 6, Math.min(radarBot - 6, node.py + bendY * 0.4));

      ctx.strokeStyle = opts.kind === 'capn' ? 'rgba(56, 189, 248, 0.85)' : 'rgba(226, 232, 240, 0.45)';
      ctx.lineWidth = 1.35;
      ctx.setLineDash([2, 2]);
      ctx.beginPath();
      ctx.moveTo(w0x, w0y);
      ctx.quadraticCurveTo(w1x, w1y, w2x, w2y);
      ctx.lineTo(w3x, w3y);
      ctx.stroke();
      ctx.setLineDash([]);

      // Draw the 3 decoded Waypoint structs along the slice(Waypoint) spline
      ctx.fillStyle = opts.kind === 'capn' ? '#38bdf8' : '#cbd5e1';
      ctx.fillRect(w1x - 1.5, w1y - 1.5, 3, 3);
      ctx.fillRect(w2x - 1.5, w2y - 1.5, 3, 3);
      ctx.fillRect(w3x - 1.5, w3y - 1.5, 3, 3);
    }

    // 2B. From (A): Draw cyclic nextRelay: ref('Flight') mesh ring (A -> B -> C -> A) with directional arrowheads
    if (meshNodes.length >= 2) {
      ctx.strokeStyle = opts.kind === 'capn' ? '#10b981' : opts.color;
      ctx.lineWidth = 1.5;
      for (let m = 0; m < meshNodes.length; m++) {
        const a = meshNodes[m];
        const b = meshNodes[(m + 1) % meshNodes.length];
        const mx = (a.px + b.px) * 0.5;
        const my = (a.py + b.py) * 0.5 - 7;
        ctx.beginPath();
        ctx.moveTo(a.px, a.py);
        ctx.quadraticCurveTo(mx, my, b.px, b.py);
        ctx.stroke();

        // Arrowhead at midpoint pointing A -> B
        const ang = Math.atan2(b.py - a.py, b.px - a.px);
        const ax = (a.px + b.px) * 0.5;
        const ay = (a.py + b.py) * 0.5 - 3.5;
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.moveTo(ax + Math.cos(ang) * 4, ay + Math.sin(ang) * 4);
        ctx.lineTo(ax + Math.cos(ang + 2.5) * 3.5, ay + Math.sin(ang + 2.5) * 3.5);
        ctx.lineTo(ax + Math.cos(ang - 2.5) * 3.5, ay + Math.sin(ang - 2.5) * 3.5);
        ctx.closePath();
        ctx.fill();
      }
    }

    // Draw decoded callsign + altitude pills on mesh nodes
    ctx.font = 'bold 7.5px ui-monospace, SFMono-Regular, monospace';
    for (let m = 0; m < Math.min(3, meshNodes.length); m++) {
      const node = meshNodes[m];
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(node.px - 2.2, node.py - 2.2, 4.4, 4.4);
      const cs = simPlainRows[node.idx].callsign;
      const altK = Math.round(simAlt[node.idx] / 1000);
      const label = m === 0 ? `${cs}·${altK}k` : cs;
      const tw = ctx.measureText(label).width + 6;
      const tx = Math.max(4, Math.min(w - tw - 4, node.px + 5));
      const ty = Math.max(radarTop + 3, Math.min(radarBot - 13, node.py - 10 + (m % 2) * 12));
      ctx.fillStyle = m === 0 ? 'rgba(6, 78, 59, 0.92)' : 'rgba(9, 13, 22, 0.88)';
      ctx.fillRect(tx, ty, tw, 11);
      ctx.strokeStyle = m === 0 ? '#10b981' : opts.color;
      ctx.lineWidth = 0.9;
      ctx.strokeRect(tx, ty, tw, 11);
      ctx.fillStyle = m === 0 ? '#a7f3d0' : '#f8fafc';
      ctx.fillText(label, tx + 3, ty + 8);
    }

    // 3. MIDDLE ZONE (128..172px): Synchronized Byte-Block X-Ray Ribbon ([Fixed 40B Slots] | [Tail Arena])
    const midY = 128;
    ctx.strokeStyle = 'rgba(148, 163, 184, 0.16)';
    ctx.beginPath();
    ctx.moveTo(0, midY);
    ctx.lineTo(w, midY);
    ctx.stroke();

    const ribX = 8;
    const ribW = w - 16;
    const ribY = midY + 12;
    const ribH = 14;
    const splitX = ribX + Math.round(ribW * 0.52);

    // Ribbon section headers
    ctx.font = 'bold 7px ui-monospace, SFMono-Regular, monospace';
    ctx.fillStyle = 'rgba(148, 163, 184, 0.78)';
    ctx.fillText('FIXED 40B #[repr(C)] SLOTS', ribX, midY + 9);
    ctx.fillStyle = opts.kind === 'capn' ? '#38bdf8' : 'rgba(148, 163, 184, 0.78)';
    ctx.fillText('TAIL ARENA (str + Waypoint[])', splitX + 4, midY + 9);

    // Left half: 8 Fixed #[repr(C)] Table Slots
    const nFixed = 8;
    const fSlotW = (splitX - ribX - 4) / nFixed;
    const activeSlotA = (lockedRing[0] ?? 0) % nFixed;
    const activeSlotB = (activeSlotA + 2) % nFixed;
    const activeSlotC = (activeSlotA + 5) % nFixed;

    for (let s = 0; s < nFixed; s++) {
      const sx = ribX + s * fSlotW;
      const isRingSlot = s === activeSlotA || s === activeSlotB || s === activeSlotC;
      if (opts.kind === 'v8') {
        ctx.fillStyle = isRingSlot ? 'rgba(245, 158, 11, 0.85)' : 'rgba(148, 163, 184, 0.18)';
        ctx.fillRect(sx + 1, ribY + (s % 2) * 3, fSlotW - 2.5, ribH - 4);
      } else if (opts.kind === 'jsc') {
        ctx.fillStyle = isRingSlot ? 'rgba(168, 85, 247, 0.85)' : 'rgba(148, 163, 184, 0.18)';
        ctx.fillRect(sx + 1, ribY + 1, fSlotW - 2, ribH - 2);
      } else {
        ctx.fillStyle = isRingSlot ? 'rgba(16, 185, 129, 0.88)' : 'rgba(16, 185, 129, 0.22)';
        ctx.fillRect(sx + 0.5, ribY + 1, fSlotW - 1.5, ribH - 2);
      }
    }

    // Right half: 6 Variable Tail Arena Blocks (str + Waypoint[])
    const tailX = splitX + 4;
    const tailW = ribX + ribW - tailX;
    const nTail = 6;
    const tSlotW = tailW / nTail;
    const activeTailA = (lockedRing[0] ?? 0) % nTail;
    const activeTailB = (activeTailA + 2) % nTail;

    for (let t = 0; t < nTail; t++) {
      const tx = tailX + t * tSlotW;
      const isHitTail = t === activeTailA || t === activeTailB;
      ctx.fillStyle =
        opts.kind === 'capn'
          ? isHitTail
            ? 'rgba(56, 189, 248, 0.88)'
            : 'rgba(56, 189, 248, 0.22)'
          : isHitTail
            ? opts.color
            : 'rgba(148, 163, 184, 0.16)';
      ctx.fillRect(tx + 0.5, ribY + 1, tSlotW - 1.5, ribH - 2);
    }

    // Draw live pointer arcs over the Byte-Block X-Ray Ribbon!
    const slotCenterX = (s: number) => ribX + (s + 0.5) * fSlotW;
    const tailCenterX = (t: number) => tailX + (t + 0.5) * tSlotW;

    if (opts.kind === 'capn') {
      // 1) Cyclic ref('Flight') pointer arcs: Slot[A] -> Slot[B] -> Slot[C] -> Slot[A]
      ctx.strokeStyle = '#34d399';
      ctx.lineWidth = 1.25;
      const pairs = [
        [activeSlotA, activeSlotB],
        [activeSlotB, activeSlotC],
        [activeSlotC, activeSlotA],
      ];
      for (const [s1, s2] of pairs) {
        const x1 = slotCenterX(s1);
        const x2 = slotCenterX(s2);
        ctx.beginPath();
        ctx.moveTo(x1, ribY + 1);
        ctx.quadraticCurveTo((x1 + x2) * 0.5, ribY - 9, x2, ribY + 1);
        ctx.stroke();
      }
      // 2) Tail slice(Waypoint) pointer arc: Slot[A].waypoints -> Tail[activeTailA]
      const sx = slotCenterX(activeSlotA);
      const tx = tailCenterX(activeTailA);
      ctx.strokeStyle = '#38bdf8';
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      ctx.moveTo(sx, ribY + ribH - 1);
      ctx.quadraticCurveTo((sx + tx) * 0.5, ribY + ribH + 8, tx, ribY + ribH - 1);
      ctx.stroke();
    }

    // Status bar below the X-Ray Ribbon
    const heapY = ribY + ribH + 4;
    const heapH = 11;
    ctx.fillStyle = 'rgba(15, 23, 42, 0.92)';
    ctx.fillRect(ribX, heapY, ribW, heapH);
    ctx.font = 'bold 7.5px ui-monospace, SFMono-Regular, monospace';
    if (opts.maxHeapMB > 0) {
      const fillRatio = Math.min(1, opts.heapMB / opts.maxHeapMB);
      ctx.fillStyle = opts.stalled ? '#ef4444' : opts.color;
      ctx.fillRect(ribX, heapY, ribW * fillRatio, heapH);
      ctx.fillStyle = '#ffffff';
      const barLabel =
        opts.kind === 'jsc'
          ? `FFI Copy: +${opts.heapMB.toFixed(1)}/${opts.maxHeapMB.toFixed(1)} MiB (str + Waypoint[])`
          : `JSON.stringify: TypeError (cyclic!) | Heap +${opts.heapMB.toFixed(1)} MB`;
      ctx.fillText(barLabel, ribX + 4, heapY + 8, ribW - 8);
    } else {
      ctx.strokeStyle = 'rgba(16, 185, 129, 0.5)';
      ctx.strokeRect(ribX, heapY, ribW, heapH);
      ctx.fillStyle = '#6ee7b7';
      const c0 = simPlainRows[lockedRing[0] ?? 0].callsign;
      const c1 = simPlainRows[lockedRing[1] ?? 1].callsign;
      const c2 = simPlainRows[lockedRing[2] ?? 2].callsign;
      const tailHex = `0x${(((lockedRing[0] ?? 0) * 40 + 6400) & 0xffff).toString(16).padStart(4, '0')}`;
      ctx.fillText(`RING: ${c0}->${c1}->${c2}->${c0} | Tail[${tailHex}] 0 Allocs`, ribX + 4, heapY + 8, ribW - 8);
    }

    // OSCILLOSCOPE ZONE (172..204px): Mini Frame-Budget Oscilloscope (above bottom DOM inspector)
    const oscTop = 172;
    const oscBot = 204;
    const oscH = oscBot - oscTop;
    ctx.strokeStyle = 'rgba(148, 163, 184, 0.16)';
    ctx.beginPath();
    ctx.moveTo(0, oscTop);
    ctx.lineTo(w, oscTop);
    ctx.stroke();

    const maxScaleMs = 22;
    const yForMs = (ms: number) => oscBot - 3 - Math.min(1, ms / maxScaleMs) * (oscH - 13);
    const y60 = yForMs(16.67);

    ctx.strokeStyle = 'rgba(239, 68, 68, 0.35)';
    ctx.setLineDash([3, 3]);
    ctx.beginPath();
    ctx.moveTo(0, y60);
    ctx.lineTo(w, y60);
    ctx.stroke();
    ctx.setLineDash([]);

    if (frameHistory.length > 1) {
      if (opts.kind === 'v8') {
        ctx.strokeStyle = 'rgba(239, 68, 68, 0.72)';
        ctx.lineWidth = 1.3;
        ctx.beginPath();
        for (let i = 0; i < frameHistory.length; i++) {
          const fx = (i / (MAX_HISTORY - 1)) * w;
          const fy = yForMs(frameHistory[i].v8Ms);
          if (i === 0) ctx.moveTo(fx, fy);
          else ctx.lineTo(fx, fy);
        }
        ctx.stroke();
      }

      const key = opts.kind === 'v8' ? 'jscMs' : opts.kind === 'jsc' ? 'rustMs' : 'capnMs';
      ctx.strokeStyle = opts.color;
      ctx.lineWidth = 2.2;
      ctx.beginPath();
      for (let i = 0; i < frameHistory.length; i++) {
        const fx = (i / (MAX_HISTORY - 1)) * w;
        const fy = yForMs(frameHistory[i][key]);
        if (i === 0) ctx.moveTo(fx, fy);
        else ctx.lineTo(fx, fy);
      }
      ctx.stroke();
    }

    ctx.font = 'bold 8px ui-monospace, SFMono-Regular, monospace';
    ctx.fillStyle = opts.color;
    ctx.fillText(opts.msLabel, 8, oscTop + 10, w - 16);
  }

  function stepLiveSimulation() {
    if (animCanvases.length === 0) return;
    frameTick++;
    // Smooth figure-8 autopilot radar probe when user is not hovering over a canvas
    if (!isPointerHovering && performance.now() - lastUserPointerTime > 650) {
      const autoX = 0.5 + Math.sin(frameTick * 0.02) * 0.34;
      const autoY = 0.5 + Math.sin(frameTick * 0.04) * 0.24;
      pointerX += (autoX - pointerX) * 0.08;
      pointerY += (autoY - pointerY) * 0.08;
    }
    const radius = Math.sqrt(simSelectivityPct / 100) * 0.42;
    const r2 = radius * radius;

    // Run real zero-copy capnstruct binary scan + cyclic ref('Flight') rewiring in browser
    const t0 = performance.now();
    let matchedCount = 0;
    let charsDecoded = 0;
    const cur = simCapnView.cursor(0);
    const scanRows = Math.min(simScale, simCapnView.length);
    for (let i = 0; i < scanRows; i++) {
      cur.seek(i);
      const dx = cur.x - pointerX;
      const dy = cur.y - pointerY;
      if (dx * dx + dy * dy <= r2) {
        matchedCount++;
        charsDecoded += cur.callsign.length;
      }
    }
    // Rewire cyclic nextRelay ring (r0 -> r1 -> r2 -> r0) in-place & traverse in O(1)
    if (lockedRing.length >= 3) {
      const r0 = lockedRing[0] % 200;
      const r1 = lockedRing[1] % 200;
      const r2 = lockedRing[2] % 200;
      simCapnView.at(r0).nextRelay = simCapnView.at(r1);
      simCapnView.at(r1).nextRelay = simCapnView.at(r2);
      simCapnView.at(r2).nextRelay = simCapnView.at(r0);
      const wp0 = simCapnView.at(r0).waypoints.at(0);
      wp0.lat = 24.5 + (1 - simFlatY[r0]) * 24.5;
      wp0.lon = -(124.8 - simFlatX[r0] * 54.0);
      let ringCur = simCapnView.at(r0);
      for (let step = 0; step < 6 && ringCur !== null; step++) {
        ringCur = ringCur.nextRelay;
      }
    }
    const rawCapnMs = Math.max(0.06, performance.now() - t0);
    if (charsDecoded < 0) console.log(charsDecoded, matchedCount);

    const scaleFactor = Math.pow(simScale / 25000, 0.65);
    const selFactor = 1 + ((simSelectivityPct - 4) / 96) * 0.35;
    const speedMult = Math.max(0.5, Math.min(1.6, 1 / Math.sqrt(scaleFactor)));

    // 1. Bun JSC (~2x vs Node V8): allocates +6.9 MB boxed objects & stalls on GC!
    let v8Gc = false;
    let jscGc = false;
    if (v8GcStall > 0) {
      v8GcStall--;
    } else if (frameTick % 2 === 0) {
      v8RadarAngle += 0.055 * speedMult;
      v8Prog += 0.095 * speedMult;
      v8HeapAccum += 0.34 * scaleFactor;
      v8PtrX += (pointerX - v8PtrX) * 0.55;
      v8PtrY += (pointerY - v8PtrY) * 0.55;
      for (let i = 0; i < 200; i++) {
        v8SnapX[i] = simFlatX[i];
        v8SnapY[i] = simFlatY[i];
      }
      if (v8HeapAccum >= 6.87) {
        v8HeapAccum = 0;
        v8GcStall = 10;
        v8Gc = true;
      }
      if (v8Prog >= 1) {
        v8Prog -= 1;
        v8Sweeps++;
      }
    }

    // 2. Rust -O3 WASM (JSON / FFI): 3.7ms scanning 5.27 MiB JSON text or 23.0ms FFI copy
    if (jscGcStall > 0) {
      jscGcStall--;
    } else {
      jscRadarAngle += 0.042 * speedMult;
      jscProg += 0.14 * speedMult;
      jscHeapAccum += 0.24 * scaleFactor;
      jscPtrX += (pointerX - jscPtrX) * 0.7;
      jscPtrY += (pointerY - jscPtrY) * 0.7;
      for (let i = 0; i < 200; i++) {
        jscSnapX[i] = simFlatX[i];
        jscSnapY[i] = simFlatY[i];
      }
      if (jscHeapAccum >= 5.27) {
        jscHeapAccum = 0;
        jscGcStall = 6;
        jscGc = true;
      }
      if (jscProg >= 1) {
        jscProg -= 1;
        jscSweeps++;
      }
    }

    // 3. capnstruct #[repr(C)]: step live aircraft positions every single frame in-place (0 MB heap, 0 GC!)
    for (let i = 0; i < 200; i++) {
      let nx = simFlatX[i] + simVelX[i];
      if (nx > 1) nx -= 1;
      if (nx < 0) nx += 1;
      const lane = i % 3;
      const baseY = lane === 0 ? 0.28 : lane === 1 ? 0.52 : 0.74;
      const targetY = baseY + Math.sin(nx * Math.PI * 2 + lane * 1.4) * 0.11;
      const ny = simFlatY[i] + (targetY - simFlatY[i]) * 0.08;
      simFlatX[i] = nx;
      simFlatY[i] = Math.max(0.12, Math.min(0.88, ny));
      cur.seek(i);
      cur.x = simFlatX[i];
      cur.y = simFlatY[i];
    }
    capnRadarAngle += 0.055 * speedMult;
    capnProg += 0.38 * speedMult;
    if (capnProg >= 1) {
      capnSweeps += Math.floor(capnProg);
      capnProg = capnProg % 1;
    }

    const steadyV8Ms = 14.14 * scaleFactor * selFactor;
    const steadyJscMs = 5.65 * scaleFactor * selFactor;
    const steadyRustMs = 3.68 * scaleFactor * selFactor;
    const steadyCapnMs = 0.17 * scaleFactor * selFactor;

    const jitter = Math.sin(frameTick * 0.21) * 0.25;
    const v8Ms = steadyV8Ms + jitter * 0.7 + (v8Gc || v8GcStall > 6 ? 11.2 : 0);
    const jscMs = steadyJscMs + jitter * 0.4 + (v8Gc || v8GcStall > 4 ? 7.8 : 0);
    const rustMs = steadyRustMs + jitter * 0.3 + (jscGc || jscGcStall > 2 ? 4.4 : 0);
    const capnMs = Math.max(0.14, 0.16 * scaleFactor + rawCapnMs * 0.2);

    frameHistory.push({ v8Ms, jscMs, rustMs, capnMs, v8Gc, jscGc });
    if (frameHistory.length > MAX_HISTORY) frameHistory.shift();

    if (swCapnEl) swCapnEl.textContent = String(capnSweeps);
    if (swRustEl) swRustEl.textContent = String(jscSweeps);
    if (swBunEl) swBunEl.textContent = String(v8Sweeps);

    // Update pointer-events:none DOM Overlay HUD + 3-line hero code block live every few ticks
    if (frameTick % 2 === 0) {
      const r0 = (lockedRing[0] ?? 0) % 200;
      const r1 = (lockedRing[1] ?? 1) % 200;
      const r2 = (lockedRing[2] ?? 2) % 200;
      const cs0 = simPlainRows[r0].callsign;
      const cs1 = simPlainRows[r1].callsign;
      const cs2 = simPlainRows[r2].callsign;
      const ringStr = `${cs0} → ${cs1} → ${cs2} → ${cs0}`;
      const f0 = simCapnView.at(r0);
      const w0 = f0.waypoints.at(0);
      const w1 = f0.waypoints.at(1);
      const lat0 = w0.lat.toFixed(1);
      const lon0 = w0.lon.toFixed(1);
      const lat1 = w1.lat.toFixed(1);
      const lon1 = w1.lon.toFixed(1);
      const byteOff = r0 * FLIGHT_STRIDE;
      if (inspOffEl) inspOffEl.textContent = `0x${byteOff.toString(16).padStart(5, '0')} (${FLIGHT_STRIDE}B)`;
      if (inspIdxEl) inspIdxEl.textContent = String(r0);
      if (inspCallEl) inspCallEl.textContent = f0.callsign;
      if (inspCoordsEl) inspCoordsEl.textContent = `${cs1} → ${cs2} → ${cs0}`;
      if (inspHexEl) inspHexEl.textContent = `[${lat0},${lon0} → ${lat1},${lon1}]`;
      const scaledMatches = Math.max(12, Math.round((matchedCount / Math.max(1, scanRows)) * simScale));
      if (codeAltEl) codeAltEl.textContent = String(lockedRing.length);
      if (codeLatEl) codeLatEl.textContent = ringStr;
      if (codeHitsEl) {
        codeHitsEl.textContent = `${scaledMatches.toLocaleString()} / ${capnMs.toFixed(2)}ms`;
      }
      if (badgeV8El) {
        if (v8GcStall > 0) {
          badgeV8El.textContent = '⚠ GC PAUSE';
          badgeV8El.classList.add('cs-ov-danger');
          badgeV8El.classList.remove('cs-ov-warn');
        } else {
          badgeV8El.textContent = `+${v8HeapAccum.toFixed(2)} MB GC`;
          badgeV8El.classList.add('cs-ov-warn');
          badgeV8El.classList.remove('cs-ov-danger');
        }
      }
      if (inspV8StateEl) {
        inspV8StateEl.textContent = v8GcStall > 0 ? '⚠ GC PAUSE' : 'CYCLIC CLONE';
      }
      if (inspV8Line1El) {
        inspV8Line1El.textContent =
          v8GcStall > 0
            ? `GC sweeping ${simScale.toLocaleString()} boxed Flight + Waypoint[]`
            : `JSON.stringify throws TypeError (cyclic ref)`;
      }
      if (inspV8Line2El) {
        inspV8Line2El.textContent = `structuredClone heap: +${v8HeapAccum.toFixed(2)} / 6.87 MB -> GC stall`;
      }
      if (badgeJscEl) {
        badgeJscEl.textContent = jscGcStall > 0 ? 'FFI COPY STALL!' : `${(23.0 * scaleFactor).toFixed(1)}ms FFI`;
      }
      if (inspJscLine1El) {
        inspJscLine1El.textContent = `Rust -O3: ${steadyRustMs.toFixed(1)}ms | FFI copy: ${(23.0 * scaleFactor).toFixed(1)}ms`;
      }
    }

    renderAnimCard(v8Canvas, {
      kind: 'v8',
      color: '#f59e0b',
      radarAng: v8RadarAngle,
      prog: v8Prog,
      sweeps: v8Sweeps,
      heapMB: v8HeapAccum,
      maxHeapMB: 6.87,
      stalled: v8GcStall > 0,
      memSub: 'Scattered Boxed Heap:',
      msLabel: `structuredClone: ${steadyV8Ms.toFixed(1)}ms V8 | ${steadyJscMs.toFixed(1)}ms Bun`,
      radius,
    });

    renderAnimCard(jscCanvas, {
      kind: 'jsc',
      color: '#a855f7',
      radarAng: jscRadarAngle,
      prog: jscProg,
      sweeps: jscSweeps,
      heapMB: jscHeapAccum,
      maxHeapMB: 5.27,
      stalled: jscGcStall > 0,
      memSub: 'serde-wasm-bindgen FFI:',
      msLabel: `Rust -O3 WASM: ${steadyRustMs.toFixed(1)}ms | FFI Copy: ${(23.0 * scaleFactor).toFixed(1)}ms`,
      radius,
    });

    renderAnimCard(capnCanvas, {
      kind: 'capn',
      color: '#10b981',
      radarAng: capnRadarAngle,
      prog: capnProg,
      sweeps: capnSweeps,
      heapMB: 0,
      maxHeapMB: 0,
      stalled: false,
      memSub: 'Shared #[repr(C)] / WasmArena:',
      msLabel: `capnstruct: ${steadyCapnMs.toFixed(2)}ms JS / ${(0.07 * scaleFactor).toFixed(2)}ms WASM (0 FFI)`,
      radius,
    });

    requestAnimationFrame(stepLiveSimulation);
  }
  requestAnimationFrame(stepLiveSimulation);

  // --- LIVE BENCHMARK RUNNER ---
  const SpdSample = defineStruct('SpdSample', {
    t: u32,
    val: f64,
    id: u32,
  });

  const TelemetryRow = defineStruct('TelemetryRow', {
    flightId: u32,
    squawk: u16,
    flags: u16,
    lat: f32,
    lon: f32,
    altBaro: i32,
    groundSpeed: f32,
    callsign: str,
    route: str,
    waypoints: slice(Waypoint),
  });

  function runBenchmarks() {
    const btn = document.getElementById('cs-run-bench') as HTMLButtonElement | null;
    if (btn) {
      btn.disabled = true;
      btn.textContent = 'Running...';
    }
    setTimeout(() => {
      // 1. 100k numeric scan
      const N1 = 100_000;
      const raw1 = Array.from({ length: N1 }, (_, i) => ({
        t: i,
        val: (i % 1000) * 0.25,
        id: i & 0xff,
      }));
      const json1 = JSON.stringify(raw1);
      const capn1 = SpdSample.pack(raw1);
      const view1 = SpdSample.array(capn1);

      const ITERS1 = 10;
      let sink = 0;
      const t1J0 = performance.now();
      for (let it = 0; it < ITERS1; it++) {
        const parsed = JSON.parse(json1);
        for (let i = 0; i < parsed.length; i++) {
          sink += parsed[i].t + parsed[i].val;
        }
      }
      const ms1Json = (performance.now() - t1J0) / ITERS1;

      const t1C0 = performance.now();
      for (let it = 0; it < ITERS1; it++) {
        for (const r of view1) {
          sink += r.t + r.val;
        }
      }
      const ms1Capn = Math.max(0.01, (performance.now() - t1C0) / ITERS1);

      updateBenchCard('b1', ms1Json, ms1Capn, '0 heap allocations');

      // 2. 25k Flight Telemetry sparse filter + lazy UTF-8 decode
      const N2 = 25_000;
      const raw2 = Array.from({ length: N2 }, (_, i) => ({
        flightId: 10000 + i,
        squawk: 1200 + (i % 77),
        flags: i & 15,
        lat: 37.0 + (i % 500) * 0.01,
        lon: -122.0 + (i % 500) * 0.01,
        altBaro: 32000,
        groundSpeed: 450.5,
        callsign: `UAL${1000 + (i % 9000)}`,
        route: 'KSFO-KORD-KJFK-EGLL',
        waypoints: [
          { lat: 37.6188, lon: -122.375 },
          { lat: 41.9742, lon: -87.9073 },
        ],
      }));
      const json2 = JSON.stringify(raw2);
      const capn2 = TelemetryRow.pack(raw2);

      const ITERS2 = 8;
      const t2J0 = performance.now();
      for (let it = 0; it < ITERS2; it++) {
        const rows = JSON.parse(json2);
        for (let i = 0; i < rows.length; i++) {
          const r = rows[i];
          if (r.lat > 41.95 && r.lon > -117.05) {
            sink += r.callsign.length;
          }
        }
      }
      const ms2Json = (performance.now() - t2J0) / ITERS2;

      const t2C0 = performance.now();
      for (let it = 0; it < ITERS2; it++) {
        const rows = TelemetryRow.array(capn2);
        for (const r of rows) {
          if (r.lat > 41.95 && r.lon > -117.05) {
            sink += r.callsign.length;
          }
        }
      }
      const ms2Capn = Math.max(0.01, (performance.now() - t2C0) / ITERS2);

      updateBenchCard('b2', ms2Json, ms2Capn, 'lazy UTF-8 decode on match only');

      // 3. Web Worker structuredClone round-trip vs capnstruct in-place mutation
      const mutBuf = capn2.slice();
      const mutView = TelemetryRow.array(mutBuf);
      const t3J0 = performance.now();
      for (let it = 0; it < 4; it++) {
        const workerCopy = structuredClone(raw2);
        for (let i = 0; i < workerCopy.length; i += 250) {
          workerCopy[i].callsign = 'UPD_999';
        }
        const mainCopy = structuredClone(workerCopy);
        sink += mainCopy[0].callsign.length;
      }
      const ms3Json = (performance.now() - t3J0) / 4;

      const t3C0 = performance.now();
      for (let it = 0; it < 20; it++) {
        const c = mutView.cursor();
        for (let i = 0; i < mutView.length; i += 250) {
          mutView.at(i, c).callsign = 'UPD_999';
        }
        sink += mutView.bytes.byteLength;
      }
      const ms3Capn = Math.max(0.005, (performance.now() - t3C0) / 20);
      updateBenchCard('b3', ms3Json, ms3Capn, '0 MB heap vs +14.2 MB');

      // 4. 10,000 Cyclic Ring Nodes (ref(() => RingNode))
      const N_RING = 10_000;
      const RING_CLUSTER = 50;
      const RingNode = defineStruct('RingNode', (self) => ({
        id: u32,
        weight: f64,
        label: str,
        next: ref(self),
        prev: ref(self),
      }));
      const jsRing = Array.from({ length: N_RING }, (_, i) =>
        RingNode.item({
          id: i,
          weight: i * 1.25,
          label: `node_${i}`,
          next: null,
          prev: null,
        }),
      );
      for (let i = 0; i < N_RING; i++) {
        const base = Math.floor(i / RING_CLUSTER) * RING_CLUSTER;
        const off = i % RING_CLUSTER;
        jsRing[i].next = jsRing[base + ((off + 1) % RING_CLUSTER)];
        jsRing[i].prev = jsRing[base + ((off + RING_CLUSTER - 1) % RING_CLUSTER)];
      }
      const capnRingBytes = RingNode.pack(jsRing);
      const ITERS4 = 10;
      const t4J0 = performance.now();
      for (let it = 0; it < ITERS4; it++) {
        const cloned = structuredClone(jsRing);
        for (let c = 0; c < N_RING; c += RING_CLUSTER) {
          let cur = cloned[c];
          for (let j = 0; j < RING_CLUSTER; j++) {
            sink += cur.weight;
            cur = cur.next;
          }
        }
      }
      const ms4Json = (performance.now() - t4J0) / ITERS4;
      const t4C0 = performance.now();
      for (let it = 0; it < ITERS4; it++) {
        const view = RingNode.array(capnRingBytes);
        let cur = view.cursor(0);
        for (let c = 0; c < N_RING; c += RING_CLUSTER) {
          cur = view.seek(c);
          for (let j = 0; j < RING_CLUSTER; j++) {
            sink += cur.weight;
            cur = cur.next;
          }
        }
      }
      const ms4Capn = Math.max(0.005, (performance.now() - t4C0) / ITERS4);
      updateBenchCard('b4', ms4Json, ms4Capn, '0 MB heap, JSON throws!');
      if (btn) {
        btn.disabled = false;
        btn.textContent = 'Re-Run Live Benchmark';
      }
      if (sink === -999999) console.log(sink);
    }, 20);
  }

  function updateBenchCard(prefix: string, msJson: number, msCapn: number, note: string) {
    const jsonEl = document.getElementById(`cs-${prefix}-json`);
    const capnEl = document.getElementById(`cs-${prefix}-capn`);
    const barEl = document.getElementById(`cs-${prefix}-bar`);
    const speedEl = document.getElementById(`cs-${prefix}-speedup`);
    const speedup = msJson / msCapn;
    if (jsonEl) jsonEl.textContent = `${msJson.toFixed(2)} ms`;
    if (capnEl) capnEl.textContent = `${msCapn.toFixed(2)} ms`;
    if (barEl) barEl.style.width = `${Math.max(1.5, Math.min(100, (msCapn / msJson) * 100))}%`;
    if (speedEl) speedEl.textContent = `${speedup.toFixed(1)}x faster (${note})`;
  }

  document.getElementById('cs-run-bench')?.addEventListener('click', runBenchmarks);

  // --- TAB 2: LIVE BINARY MUTATOR & INSPECTOR ---
  const User = defineStruct('User', {
    id: u32,
    name: str,
    scores: slice(u32),
  });

  const initialUsers = pack(User, [
    { id: 1, name: 'Ada Lovelace', scores: [10, 20, 30] },
    { id: 2, name: 'Alan Turing', scores: [40, 50] },
  ]);
  const usersView = User.array(initialUsers);
  let nextId = 3;

  function formatHexDump(bytes: Uint8Array, rowCount: number, stride: number): string {
    const tableBytes = rowCount * stride;
    const lines: string[] = [];
    lines.push(
      `// TBL #[repr(C)]: 0x00..0x${tableBytes.toString(16).padStart(2, '0')} (${tableBytes}B) | TAIL +${Math.max(0, bytes.byteLength - tableBytes)}B (${bytes.byteLength}B)`
    );
    for (let off = 0; off < bytes.byteLength; off += 8) {
      const hexParts: string[] = [];
      let ascii = '';
      for (let i = 0; i < 8; i++) {
        if (off + i < bytes.byteLength) {
          const b = bytes[off + i];
          hexParts.push(b.toString(16).padStart(2, '0'));
          ascii += b >= 32 && b <= 126 ? String.fromCharCode(b) : '.';
        } else {
          hexParts.push('  ');
          ascii += ' ';
        }
      }
      const region = off < tableBytes ? 'TBL ' : 'TAIL';
      lines.push(
        `${region} 0x${off.toString(16).padStart(4, '0')}: ${hexParts.slice(0, 4).join(' ')}  ${hexParts.slice(4).join(' ')}  |${ascii}|`
      );
    }
    return lines.join('\n');
  }

  const mutCodeLineEl = document.getElementById('cs-mut-code-line');
  const mutCodeCommentEl = document.getElementById('cs-mut-code-comment');
  let mutPulseTimer = 0;

  function renderMutator(actionLabel: string, codeLine?: string, codeComment?: string) {
    const lenEl = document.getElementById('cs-st-len');
    const strideEl = document.getElementById('cs-st-stride');
    const bytesEl = document.getElementById('cs-st-bytes');
    const fragEl = document.getElementById('cs-st-frag');
    const actEl = document.getElementById('cs-st-action');
    const listEl = document.getElementById('cs-rows-editor');
    const hexEl = document.getElementById('cs-hex-view');

    const rawSlice = new Uint8Array(
      usersView.buffer,
      usersView.byteOffset,
      usersView.usedByteLength,
    );
    if (lenEl) lenEl.textContent = String(usersView.length);
    if (strideEl) strideEl.textContent = `${usersView.stride} B`;
    if (bytesEl) bytesEl.textContent = `${rawSlice.byteLength} B`;
    if (fragEl)
      fragEl.textContent = `${(usersView.compactionRatio * 100).toFixed(1)}% (${usersView.deadByteLength} B dead)`;
    if (actEl) actEl.textContent = actionLabel;
    if (codeLine && mutCodeLineEl) {
      mutCodeLineEl.textContent = codeLine;
      mutCodeLineEl.classList.add('cs-live-pulse');
      if (mutPulseTimer) window.clearTimeout(mutPulseTimer);
      mutPulseTimer = window.setTimeout(() => mutCodeLineEl.classList.remove('cs-live-pulse'), 220);
    }
    if (codeComment && mutCodeCommentEl) {
      mutCodeCommentEl.textContent = codeComment;
    }
    if (hexEl)
      hexEl.textContent = formatHexDump(rawSlice, usersView.length, usersView.stride);

    if (listEl) {
      listEl.innerHTML = '';
      for (let i = 0; i < usersView.length; i++) {
        const u = usersView.at(i);
        const rowDiv = document.createElement('div');
        rowDiv.className = 'cs-row-item';

        const idSpan = document.createElement('span');
        idSpan.innerHTML = `<code>#${u.id}</code>`;

        const nameInput = document.createElement('input');
        nameInput.value = u.name;
        nameInput.title = 'Edit row.name (in-place when <= current UTF-8 length, tail-append when longer)';
        nameInput.addEventListener('change', () => {
          const prevDead = usersView.deadByteLength;
          const prevLen = new TextEncoder().encode(usersView.at(i).name).byteLength;
          const nextLen = new TextEncoder().encode(nameInput.value).byteLength;
          usersView.at(i).name = nameInput.value;
          const nextDead = usersView.deadByteLength;
          const msg =
            nextLen <= prevLen
              ? `row[${i}].name overwritten in-place (0 allocs)`
              : nextDead === prevDead
                ? `row[${i}].name extended in-place at tail tip (0 dead bytes)`
                : `row[${i}].name bump-allocated in tail arena (+${nextDead - prevDead} B reclaimable)`;
          renderMutator(
            msg,
            `users.at(${i}).name = ${JSON.stringify(nameInput.value)};`,
            `// -> ${msg} (${usersView.usedByteLength} B used, ${usersView.deadByteLength} B dead)`,
          );
        });

        const scoresInput = document.createElement('input');
        scoresInput.value = Array.from(u.scores).join(', ');
        scoresInput.title = 'Comma-separated u32 slice values';
        scoresInput.addEventListener('change', () => {
          const nums = scoresInput.value
            .split(',')
            .map((s) => parseInt(s.trim(), 10))
            .filter((n) => !Number.isNaN(n) && n >= 0);
          usersView.at(i).set({ scores: nums });
          renderMutator(
            `Updated row[${i}].scores (${nums.length} u32 items)`,
            `users.at(${i}).scores = [${nums.join(', ')}];`,
            `// -> updated slice(u32) (${nums.length} items, ${usersView.usedByteLength} B used, ${usersView.deadByteLength} B dead)`,
          );
        });

        rowDiv.append(idSpan, nameInput, scoresInput);
        listEl.appendChild(rowDiv);
      }
    }
  }

  document.getElementById('cs-btn-shorter')?.addEventListener('click', () => {
    if (usersView.length === 0) return;
    usersView.at(0).name = 'Ada';
    renderMutator(
      'usersView.at(0).name = "Ada" -> overwritten in-place (0 allocs)',
      `users.at(0).name = 'Ada';`,
      `// -> overwrote UTF-8 slot in-place (0 allocs, ${usersView.deadByteLength} B reclaimable tail)`,
    );
  });

  document.getElementById('cs-btn-longer')?.addEventListener('click', () => {
    if (usersView.length === 0) return;
    usersView.at(0).name = 'Countess Ada Lovelace (Analytical Engine)';
    renderMutator(
      'usersView.at(0).name = "Countess Ada..." -> tail-arena bump alloc',
      `users.at(0).name = 'Countess Ada Lovelace (Analytical Engine)';`,
      `// -> bump-allocated at tail end & updated [u32 relOff, u32 len] (${usersView.usedByteLength} B used, ${usersView.deadByteLength} B dead)`,
    );
  });

  document.getElementById('cs-btn-push')?.addEventListener('click', () => {
    const id = nextId++;
    usersView.push({ id, name: `Engineer_${id}`, scores: [id * 10, id * 20] });
    renderMutator(
      `users.push({ id: ${id}, ... })`,
      `users.push({ id: ${id}, name: 'Engineer_${id}', scores: [${id * 10}, ${id * 20}] });`,
      `// -> appended row #${usersView.length - 1} (${usersView.length} rows, ${usersView.usedByteLength} B wire buffer)`,
    );
  });

  document.getElementById('cs-btn-pop')?.addEventListener('click', () => {
    const popped = usersView.pop();
    renderMutator(
      popped ? `users.pop() -> #${popped.id}` : 'users.pop() (empty)',
      `const popped = users.pop();`,
      popped
        ? `// -> removed #${popped.id} ('${popped.name}') in O(1) (${usersView.length} rows remaining)`
        : `// -> table is already empty (0 rows)`,
    );
  });

  document.getElementById('cs-btn-compact')?.addEventListener('click', () => {
    const packed = usersView.compact();
    renderMutator(
      `users.compact() -> ${packed.byteLength} B tight wire buffer (0% dead tail)`,
      `const wireBytes = users.compact();`,
      `// -> stripped dead tail bytes into tight ${packed.byteLength} B Uint8Array (0% dead tail)`,
    );
  });

  renderMutator('Initialized 2-row #[repr(C)] buffer');

  // --- TAB 3: RUST #[repr(C)] CODEGEN ---
  const OutHit = defineStruct('OutHit', {
    fid: u32,
    lat: f64,
    lon: f64,
    tStart: f64,
    tEnd: f64,
    fids: fixedArray(u32, 8),
  });

  const PaddedAlignment = defineStruct('PaddedAlignment', {
    big: u64,
    flag: u8,
    code: u16,
    samples: slice(i32),
  });
  const GraphNode = defineStruct('GraphNode', (self) => ({
    id: u32,
    weight: f64,
    label: str,
    next: ref(self),
    children: slice(self),
  }));

  const presets: Record<string, { ts: string; structs: StructDefLike[] }> = {
    telemetry: {
      ts: `const Waypoint = defineStruct('Waypoint', {
  lat: f32,                   // offset 0, size 4
  lon: f32,                   // offset 4, size 4
}); // size: 8, align: 4

const TelemetryRow = defineStruct('TelemetryRow', {
  flightId: u32,              // offset 0
  squawk: u16,                // offset 4
  flags: u16,                 // offset 6
  lat: f32,                   // offset 8
  lon: f32,                   // offset 12
  altBaro: i32,               // offset 16
  groundSpeed: f32,           // offset 20
  callsign: str,              // offset 24 ([u32 off, u32 len])
  route: str,                 // offset 32 ([u32 off, u32 len])
  waypoints: slice(Waypoint), // offset 40 ([u32 off, u32 len])
}); // size: 48, align: 4

// Allocate directly inside WebAssembly.Memory (0 FFI copy):
const { view, ptr, len } = TelemetryRow.inWasm(wasmExports, rows);
wasmExports.inspect_fleet(ptr, len);`,
      structs: [Waypoint, TelemetryRow],
    },
    graph: {
      ts: `const GraphNode = defineStruct('GraphNode', (self) => ({
  id: u32,               // offset 0, size 4 (+4B padding before f64)
  weight: f64,           // offset 8, size 8
  label: str,            // offset 16, size 8 (CapnStr)
  next: ref(self),       // offset 24, size 8 (CapnRef<GraphNode>)
  children: slice(self),   // offset 32, size 8 (CapnSlice<GraphNode>)
})); // size: 40, align: 8

// Pack cyclic graph directly into WebAssembly.Memory:
const { view, ptr, len } = GraphNode.inWasm(wasmArena, nodes);
wasmExports.traverse_graph(ptr, len);`,
      structs: [GraphNode],
    },
    spdsample: {
      ts: `const SpdSample = defineStruct('SpdSample', {
  t: u32,                   // offset 0 (4B padding auto-inserted after t)
  val: f64,                 // offset 8, align 8
  id: u32,                  // offset 16 (4B trailing padding to align stride to 8)
}); // size: 24, align: 8

const OutHit = defineStruct('OutHit', {
  fid: u32,                 // offset 0 (4B padding before lat)
  lat: f64,                 // offset 8
  lon: f64,                 // offset 16
  tstart: f64,              // offset 24
  tend: f64,                // offset 32
  fids: fixedArray(u32, 8),// offset 40..72
}); // size: 72, align: 8

// Allocate zero-copy output buffer in WASM linear memory:
const { view: hits, ptr, len } = OutHit.inWasm(wasmArena, 256);
wasmExports.search_kernel(samplesPtr, samplesLen, ptr, len);`,
      structs: [SpdSample, OutHit],
    },
    padded: {
      ts: `const PaddedAlignment = defineStruct('PaddedAlignment', {
  big: u64,            // offset 0, align 8
  flag: u8,            // offset 8, align 1 (+1B pad before code)
  code: u16,           // offset 10, align 2
  samples: slice(i32),     // offset 16, align 4 (8B CapnSlice<i32>)
}); // size: 24, align: 8

const { view, ptr, len } = PaddedAlignment.inWasm(wasmMem, 1024);`,
      structs: [PaddedAlignment],
    },
  };

  let currentSchemaKey = 'telemetry';
  let currentTarget = 'rust';
  const labelEl = document.getElementById('cs-codegen-label');
  const tsEl = document.getElementById('cs-ts-schema');
  const rsEl = document.getElementById('cs-rust-output');

  function renderRustCodegen() {
    const preset = presets[currentSchemaKey] ?? presets.telemetry;
    if (tsEl) tsEl.textContent = preset.ts;
    if (labelEl) {
      labelEl.innerHTML =
        currentTarget === 'go-wasm'
          ? 'Generated Go / TinyGo WASM <code>toGoStruct([...], { wasm: true })</code> Output:'
          : currentTarget === 'go'
            ? 'Generated Go <code>toGoStruct([...])</code> Output:'
            : 'Generated Rust <code>toRustReprC([...])</code> Output (with Compile-Time Layout Assertions):';
    }
    if (rsEl) {
      rsEl.textContent =
        currentTarget === 'go-wasm'
          ? toGoStruct(preset.structs, { wasm: true })
          : currentTarget === 'go'
            ? toGoStruct(preset.structs)
            : toRustReprC(preset.structs);
    }
  }

  document.querySelectorAll<HTMLButtonElement>('#cs-schema-pills .cs-mini-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#cs-schema-pills .cs-mini-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      currentSchemaKey = btn.dataset.schema || 'telemetry';
      renderRustCodegen();
    });
  });
  document.querySelectorAll<HTMLButtonElement>('#cs-target-pills .cs-mini-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#cs-target-pills .cs-mini-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      currentTarget = btn.dataset.target || 'rust';
      renderRustCodegen();
    });
  });
  renderRustCodegen();
</script>
