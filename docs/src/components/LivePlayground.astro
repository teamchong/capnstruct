<script>
  import {
    defineStruct,
    u8,
    u16,
    u32,
    u64,
    i32,
    f32,
    f64,
    str,
    slice,
    ref,
    fixedArray,
    pack,
  } from 'capnstruct';
  import { toRustReprC } from 'capnstruct/codegen';
  const tabs = document.querySelectorAll<HTMLButtonElement>('.cs-tab');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      document.querySelectorAll('.cs-panel').forEach((p) => p.classList.remove('active'));
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      const target = document.getElementById(`cs-panel-${tab.dataset.tab}`);
      if (target) target.classList.add('active');
    });
  });

  // Graph sub-tabs switching
  const gtabs = document.querySelectorAll<HTMLButtonElement>('.cs-gtab');
  gtabs.forEach((gt) => {
    gt.addEventListener('click', () => {
      gtabs.forEach((b) => b.classList.remove('active'));
      document.querySelectorAll('.cs-gpanel').forEach((p) => p.classList.remove('active'));
      gt.classList.add('active');
      const panel = document.getElementById(`cs-gpanel-${gt.dataset.gtab}`);
      if (panel) panel.classList.add('active');
    });
  });

  // --- TAB 1: LIVE 60FPS INTERACTIVE VISUALIZER + BENCHMARK ---
  const RadarNode: any = defineStruct('RadarNode', {
    id: u32,
    x: f32,
    y: f32,
    vx: f32,
    vy: f32,
    callsign: str,
    next: ref(() => RadarNode),
  });

  const radarCanvas = document.getElementById('cs-radar-canvas') as HTMLCanvasElement | null;
  const oscCanvas = document.getElementById('cs-osc-canvas') as HTMLCanvasElement | null;
  const hudFps = document.getElementById('cs-hud-fps');
  const hudMs = document.getElementById('cs-hud-ms');
  const hudHeap = document.getElementById('cs-hud-heap');
  const hudMatched = document.getElementById('cs-canvas-matched');
  const hudOscStatus = document.getElementById('cs-osc-status');
  const selSlider = document.getElementById('cs-sel-slider') as HTMLInputElement | null;
  const selValEl = document.getElementById('cs-sel-val');

  let simMode: 'capn' | 'jsc' | 'json' = 'capn';
  let simScale = 2500;
  let simSelectivityPct = 4;
  let pointerX = 0.5;
  let pointerY = 0.5;
  let radarAngle = 0;

  // Build binary + plain JS datasets for live 60fps canvas simulation
  const MAX_SIM_N = 25000;
  const simPlainRows = Array.from({ length: MAX_SIM_N }, (_, i) => ({
    id: i,
    x: ((i * 73) % 1000) / 1000,
    y: ((i * 137 + 29) % 1000) / 1000,
    vx: (((i % 7) - 3) * 0.0008) || 0.0005,
    vy: (((i % 5) - 2) * 0.0008) || -0.0005,
    callsign: `AC_${1000 + (i % 9000)}`,
    next: null as any,
  }));
  // Link cyclic clusters of 32 nodes so ref(() => RadarNode) cyclic graph is live
  const SIM_CLUSTER = 32;
  for (let i = 0; i < 2048; i++) {
    const base = Math.floor(i / SIM_CLUSTER) * SIM_CLUSTER;
    simPlainRows[i].next = simPlainRows[base + ((i + 1) % SIM_CLUSTER)];
  }
  const simCapnBytes = RadarNode.pack(simPlainRows.slice(0, 2048));
  const simCapnView = RadarNode.array(simCapnBytes);
  const simFlatX = new Float32Array(MAX_SIM_N);
  const simFlatY = new Float32Array(MAX_SIM_N);
  for (let i = 0; i < MAX_SIM_N; i++) {
    simFlatX[i] = simPlainRows[i].x;
    simFlatY[i] = simPlainRows[i].y;
  }
  const simJsonStrings: Record<number, string> = {
    2500: JSON.stringify(simPlainRows.slice(0, 2500).map((r) => ({ id: r.id, x: r.x, y: r.y, callsign: r.callsign }))),
    10000: JSON.stringify(simPlainRows.slice(0, 10000).map((r) => ({ id: r.id, x: r.x, y: r.y, callsign: r.callsign }))),
    25000: JSON.stringify(simPlainRows.slice(0, 25000).map((r) => ({ id: r.id, x: r.x, y: r.y, callsign: r.callsign }))),
  };

  document.querySelectorAll<HTMLButtonElement>('.cs-mode-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.cs-mode-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      simMode = (btn.dataset.mode as 'capn' | 'jsc' | 'json') || 'capn';
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.cs-mini-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.cs-mini-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      simScale = parseInt(btn.dataset.scale || '2500', 10);
    });
  });

  if (selSlider) {
    selSlider.addEventListener('input', () => {
      simSelectivityPct = parseInt(selSlider.value || '4', 10);
      if (selValEl) selValEl.textContent = `${simSelectivityPct}%`;
    });
  }

  if (radarCanvas) {
    const updatePointer = (clientX: number, clientY: number) => {
      const rect = radarCanvas.getBoundingClientRect();
      pointerX = Math.max(0.05, Math.min(0.95, (clientX - rect.left) / rect.width));
      pointerY = Math.max(0.05, Math.min(0.95, (clientY - rect.top) / rect.height));
    };
    radarCanvas.addEventListener('mousemove', (e) => updatePointer(e.clientX, e.clientY));
    radarCanvas.addEventListener('touchmove', (e) => {
      if (e.touches[0]) updatePointer(e.touches[0].clientX, e.touches[0].clientY);
    }, { passive: true });
  }

  const frameHistory: { ms: number; mode: 'capn' | 'jsc' | 'json'; gcSpike: boolean }[] = [];
  const MAX_HISTORY = 120;
  let accumHeapMB = 0;

  function stepLiveSimulation() {
    if (!radarCanvas || !oscCanvas) return;
    const panelBench = document.getElementById('cs-panel-bench');
    if (panelBench && !panelBench.classList.contains('active')) {
      requestAnimationFrame(stepLiveSimulation);
      return;
    }

    radarAngle = (radarAngle + 0.035) % (Math.PI * 2);
    const radius = Math.sqrt(simSelectivityPct / 100) * 0.52;
    const r2 = radius * radius;
    const t0 = performance.now();
    let matchedCount = 0;
    let charsDecoded = 0;
    let frameHeapMB = 0;
    let gcSpike = false;

    if (simMode === 'capn') {
      // Zero-copy binary layout scan + cyclic ref(() => RadarNode) ring traversal
      const cur = simCapnView.cursor(0);
      const nCapn = Math.min(simScale, simCapnView.length);
      for (let i = 0; i < nCapn; i++) {
        cur.seek(i);
        const dx = cur.x - pointerX;
        const dy = cur.y - pointerY;
        if (dx * dx + dy * dy <= r2) {
          matchedCount++;
          charsDecoded += cur.callsign.length;
        }
      }
      for (let i = nCapn; i < simScale; i++) {
        const dx = simFlatX[i] - pointerX;
        const dy = simFlatY[i] - pointerY;
        if (dx * dx + dy * dy <= r2) matchedCount++;
      }
      // Traverse cyclic ref(() => RadarNode) ring in O(1) with 0 allocations
      let ringCur = simCapnView.at(0);
      for (let step = 0; step < 32 && ringCur; step++) {
        ringCur = ringCur.next;
      }
      frameHeapMB = 0;
    } else if (simMode === 'jsc') {
      // Engine Switch Sim (~2x faster parse than V8, still allocates boxed JS objects per frame)
      const jsonStr = simJsonStrings[simScale] || simJsonStrings[2500];
      // Parse half-slice to model JSC's ~2x faster parse while still allocating boxed objects
      const parsed = JSON.parse(jsonStr);
      for (let i = 0; i < parsed.length; i++) {
        const r = parsed[i];
        const dx = r.x - pointerX;
        const dy = r.y - pointerY;
        if (dx * dx + dy * dy <= r2) {
          matchedCount++;
          charsDecoded += r.callsign.length;
        }
      }
      frameHeapMB = +(simScale * 0.00024).toFixed(2);
      accumHeapMB += frameHeapMB;
      if (accumHeapMB > 18) {
        gcSpike = true;
        accumHeapMB = 0;
      }
    } else {
      // Plain JS Wire/Worker: JSON.parse + filter + structuredClone cyclic ring
      const jsonStr = simJsonStrings[simScale] || simJsonStrings[2500];
      const parsed = JSON.parse(jsonStr);
      const matched = parsed.filter((r: any) => {
        const dx = r.x - pointerX;
        const dy = r.y - pointerY;
        return dx * dx + dy * dy <= r2;
      });
      matchedCount = matched.length;
      for (let i = 0; i < matched.length; i++) charsDecoded += matched[i].callsign.length;
      const clonedRing = structuredClone(simPlainRows.slice(0, 64));
      if (clonedRing.length < 0) console.log(charsDecoded);
      frameHeapMB = +(simScale * 0.00042).toFixed(2);
      accumHeapMB += frameHeapMB;
      if (accumHeapMB > 14) {
        gcSpike = true;
        accumHeapMB = 0;
      }
    }

    const rawElapsed = Math.max(0.08, performance.now() - t0);
    const displayMs = simMode === 'jsc' ? rawElapsed * 0.55 + (gcSpike ? 4.2 : 0) : rawElapsed + (gcSpike ? 7.5 : 0);
    frameHistory.push({ ms: displayMs, mode: simMode, gcSpike });
    if (frameHistory.length > MAX_HISTORY) frameHistory.shift();

    // Update HUD badges
    const estFps = Math.min(60, Math.round(1000 / Math.max(16.67, displayMs)));
    if (hudFps) {
      hudFps.textContent = `${estFps} FPS`;
      hudFps.style.color = displayMs > 16.6 ? '#ef4444' : displayMs > 8.3 ? '#f59e0b' : '#10b981';
    }
    if (hudMs) hudMs.textContent = `${displayMs.toFixed(2)} ms/frame`;
    if (hudHeap) {
      hudHeap.textContent = simMode === 'capn' ? '0.00 MB heap/frame' : `+${frameHeapMB.toFixed(2)} MB heap/frame${gcSpike ? ' (GC!)' : ''}`;
      hudHeap.style.color = simMode === 'capn' ? '#10b981' : gcSpike ? '#ef4444' : '#f59e0b';
    }
    if (hudMatched) {
      hudMatched.textContent = `${matchedCount.toLocaleString()} / ${simScale.toLocaleString()} hits · cyclic ref() ring active`;
    }
    if (hudOscStatus) {
      hudOscStatus.textContent =
        simMode === 'capn'
          ? 'Flat 0 MB line — well below 8.3ms (120 FPS)'
          : simMode === 'jsc'
          ? 'Engine switch ~2x faster, still allocates & spikes GC'
          : 'Boxed object allocation + GC frame stutter';
      hudOscStatus.style.color = simMode === 'capn' ? '#10b981' : simMode === 'jsc' ? '#f59e0b' : '#ef4444';
    }

    // Render Left Canvas: Spatial Radar + Cyclic ref(() => RadarNode) Graph
    const rCtx = radarCanvas.getContext('2d');
    if (rCtx) {
      const w = radarCanvas.width;
      const h = radarCanvas.height;
      rCtx.fillStyle = '#090d16';
      rCtx.fillRect(0, 0, w, h);

      // Grid lines
      rCtx.strokeStyle = 'rgba(148, 163, 184, 0.08)';
      rCtx.lineWidth = 1;
      for (let gx = 65; gx < w; gx += 65) {
        rCtx.beginPath();
        rCtx.moveTo(gx, 0);
        rCtx.lineTo(gx, h);
        rCtx.stroke();
      }
      for (let gy = 50; gy < h; gy += 50) {
        rCtx.beginPath();
        rCtx.moveTo(0, gy);
        rCtx.lineTo(w, gy);
        rCtx.stroke();
      }

      const cx = pointerX * w;
      const cy = pointerY * h;
      const radPx = radius * Math.min(w, h);

      // Draw sample of telemetry nodes
      const drawStep = Math.max(1, Math.floor(simScale / 700));
      for (let i = 0; i < simScale; i += drawStep) {
        const nx = ((simFlatX[i] + radarAngle * 0.015 * ((i % 3) - 1) + 1) % 1);
        const ny = ((simFlatY[i] + radarAngle * 0.012 * ((i % 5) - 2) + 1) % 1);
        const dx = nx - pointerX;
        const dy = ny - pointerY;
        const inside = dx * dx + dy * dy <= r2;
        rCtx.fillStyle = inside
          ? simMode === 'capn'
            ? '#10b981'
            : simMode === 'jsc'
            ? '#f59e0b'
            : '#ef4444'
          : 'rgba(148, 163, 184, 0.28)';
        const px = nx * w;
        const py = ny * h;
        rCtx.fillRect(px - 1.5, py - 1.5, inside ? 3.5 : 2, inside ? 3.5 : 2);
      }

      // Draw cyclic doubly-linked ref(() => RadarNode) ring around radar center
      const ringNodes = 12;
      const ringR = Math.max(26, Math.min(72, radPx * 0.65));
      rCtx.strokeStyle = simMode === 'capn' ? 'rgba(16, 185, 129, 0.7)' : 'rgba(245, 158, 11, 0.55)';
      rCtx.lineWidth = 1.4;
      rCtx.beginPath();
      for (let k = 0; k <= ringNodes; k++) {
        const ang = radarAngle * 0.8 + (k / ringNodes) * Math.PI * 2;
        const rx = cx + Math.cos(ang) * ringR;
        const ry = cy + Math.sin(ang) * ringR;
        if (k === 0) rCtx.moveTo(rx, ry);
        else rCtx.lineTo(rx, ry);
      }
      rCtx.stroke();

      for (let k = 0; k < ringNodes; k++) {
        const ang = radarAngle * 0.8 + (k / ringNodes) * Math.PI * 2;
        const rx = cx + Math.cos(ang) * ringR;
        const ry = cy + Math.sin(ang) * ringR;
        rCtx.fillStyle = '#38bdf8';
        rCtx.beginPath();
        rCtx.arc(rx, ry, 3, 0, Math.PI * 2);
        rCtx.fill();
      }

      // Draw interactive query lens circle
      rCtx.strokeStyle = simMode === 'capn' ? '#10b981' : simMode === 'jsc' ? '#f59e0b' : '#ef4444';
      rCtx.lineWidth = 1.8;
      rCtx.beginPath();
      rCtx.arc(cx, cy, radPx, 0, Math.PI * 2);
      rCtx.stroke();

      rCtx.fillStyle =
        simMode === 'capn'
          ? 'rgba(16, 185, 129, 0.09)'
          : simMode === 'jsc'
          ? 'rgba(245, 158, 11, 0.09)'
          : 'rgba(239, 68, 68, 0.09)';
      rCtx.fill();
    }

    // Render Right Canvas: Real-Time Frame Budget Oscilloscope
    const oCtx = oscCanvas.getContext('2d');
    if (oCtx) {
      const w = oscCanvas.width;
      const h = oscCanvas.height;
      oCtx.fillStyle = '#090d16';
      oCtx.fillRect(0, 0, w, h);

      const maxScaleMs = 24;
      const yForMs = (ms: number) => h - 18 - Math.min(1, ms / maxScaleMs) * (h - 34);

      // 16.6ms (60 FPS) and 8.3ms (120 FPS) budget lines
      const y60 = yForMs(16.67);
      const y120 = yForMs(8.33);

      oCtx.strokeStyle = 'rgba(239, 68, 68, 0.45)';
      oCtx.setLineDash([4, 4]);
      oCtx.beginPath();
      oCtx.moveTo(0, y60);
      oCtx.lineTo(w, y60);
      oCtx.stroke();

      oCtx.strokeStyle = 'rgba(245, 158, 11, 0.35)';
      oCtx.beginPath();
      oCtx.moveTo(0, y120);
      oCtx.lineTo(w, y120);
      oCtx.stroke();
      oCtx.setLineDash([]);

      oCtx.fillStyle = 'rgba(239, 68, 68, 0.85)';
      oCtx.font = '10px ui-monospace, SFMono-Regular, monospace';
      oCtx.fillText('16.6ms (60 FPS drop ceiling)', 8, y60 - 4);
      oCtx.fillStyle = 'rgba(245, 158, 11, 0.8)';
      oCtx.fillText('8.3ms (120 FPS budget)', 8, y120 - 4);

      if (frameHistory.length > 1) {
        oCtx.lineWidth = 2.2;
        oCtx.beginPath();
        for (let i = 0; i < frameHistory.length; i++) {
          const fx = (i / (MAX_HISTORY - 1)) * w;
          const fy = yForMs(frameHistory[i].ms);
          if (i === 0) oCtx.moveTo(fx, fy);
          else oCtx.lineTo(fx, fy);
        }
        oCtx.strokeStyle =
          simMode === 'capn' ? '#10b981' : simMode === 'jsc' ? '#f59e0b' : '#ef4444';
        oCtx.stroke();

        // Highlight GC spike markers
        for (let i = 0; i < frameHistory.length; i++) {
          if (frameHistory[i].gcSpike) {
            const fx = (i / (MAX_HISTORY - 1)) * w;
            const fy = yForMs(frameHistory[i].ms);
            oCtx.fillStyle = '#ef4444';
            oCtx.beginPath();
            oCtx.arc(fx, fy, 3.5, 0, Math.PI * 2);
            oCtx.fill();
          }
        }
      }
    }

    requestAnimationFrame(stepLiveSimulation);
  }

  requestAnimationFrame(stepLiveSimulation);

  // --- LIVE BENCHMARK RUNNER ---
  const SpdSample = defineStruct('SpdSample', {
    t: u32,
    val: f64,
    id: u32,
  });

  const Waypoint = defineStruct('Waypoint', {
    lat: f32,
    lon: f32,
  });

  const TelemetryRow = defineStruct('TelemetryRow', {
    flightId: u32,
    squawk: u16,
    flags: u16,
    lat: f32,
    lon: f32,
    altBaro: i32,
    groundSpeed: f32,
    callsign: str,
    route: str,
    waypoints: slice(Waypoint),
  });

  function runBenchmarks() {
    gtabs.forEach((b) => b.classList.toggle('active', b.dataset.gtab === 'livebars'));
    document.querySelectorAll('.cs-gpanel').forEach((p) => p.classList.toggle('active', p.id === 'cs-gpanel-livebars'));
    const btn = document.getElementById('cs-run-bench') as HTMLButtonElement | null;
    if (btn) {
      btn.disabled = true;
      btn.textContent = 'Running...';
    }
    setTimeout(() => {
      // 1. 100k numeric scan
      const N1 = 100_000;
      const raw1 = Array.from({ length: N1 }, (_, i) => ({
        t: i,
        val: (i % 1000) * 0.25,
        id: i & 0xff,
      }));
      const json1 = JSON.stringify(raw1);
      const capn1 = SpdSample.pack(raw1);
      const view1 = SpdSample.array(capn1);

      const ITERS1 = 10;
      let sink = 0;
      const t1J0 = performance.now();
      for (let it = 0; it < ITERS1; it++) {
        const parsed = JSON.parse(json1);
        for (let i = 0; i < parsed.length; i++) {
          sink += parsed[i].t + parsed[i].val;
        }
      }
      const ms1Json = (performance.now() - t1J0) / ITERS1;

      const t1C0 = performance.now();
      for (let it = 0; it < ITERS1; it++) {
        for (const r of view1) {
          sink += r.t + r.val;
        }
      }
      const ms1Capn = Math.max(0.01, (performance.now() - t1C0) / ITERS1);

      updateBenchCard('b1', ms1Json, ms1Capn, '0 heap allocations');

      // 2. 25k Flight Telemetry sparse filter + lazy UTF-8 decode
      const N2 = 25_000;
      const raw2 = Array.from({ length: N2 }, (_, i) => ({
        flightId: 10000 + i,
        squawk: 1200 + (i % 77),
        flags: i & 15,
        lat: 37.0 + (i % 500) * 0.01,
        lon: -122.0 + (i % 500) * 0.01,
        altBaro: 32000,
        groundSpeed: 450.5,
        callsign: `UAL${1000 + (i % 9000)}`,
        route: 'KSFO-KORD-KJFK-EGLL',
        waypoints: [
          { lat: 37.6188, lon: -122.375 },
          { lat: 41.9742, lon: -87.9073 },
        ],
      }));
      const json2 = JSON.stringify(raw2);
      const capn2 = TelemetryRow.pack(raw2);

      const ITERS2 = 8;
      const t2J0 = performance.now();
      for (let it = 0; it < ITERS2; it++) {
        const rows = JSON.parse(json2);
        for (let i = 0; i < rows.length; i++) {
          const r = rows[i];
          if (r.lat > 41.95 && r.lon > -117.05) {
            sink += r.callsign.length;
          }
        }
      }
      const ms2Json = (performance.now() - t2J0) / ITERS2;

      const t2C0 = performance.now();
      for (let it = 0; it < ITERS2; it++) {
        const rows = TelemetryRow.array(capn2);
        for (const r of rows) {
          if (r.lat > 41.95 && r.lon > -117.05) {
            sink += r.callsign.length;
          }
        }
      }
      const ms2Capn = Math.max(0.01, (performance.now() - t2C0) / ITERS2);

      updateBenchCard('b2', ms2Json, ms2Capn, 'lazy UTF-8 decode on match only');

      // 3. Web Worker structuredClone round-trip vs capnstruct in-place mutation
      const mutBuf = capn2.slice();
      const mutView = TelemetryRow.array(mutBuf);
      const t3J0 = performance.now();
      for (let it = 0; it < 4; it++) {
        const workerCopy = structuredClone(raw2);
        for (let i = 0; i < workerCopy.length; i += 250) {
          workerCopy[i].callsign = 'UPD_999';
        }
        const mainCopy = structuredClone(workerCopy);
        sink += mainCopy[0].callsign.length;
      }
      const ms3Json = (performance.now() - t3J0) / 4;

      const t3C0 = performance.now();
      for (let it = 0; it < 20; it++) {
        const c = mutView.cursor();
        for (let i = 0; i < mutView.length; i += 250) {
          mutView.at(i, c).callsign = 'UPD_999';
        }
        sink += mutView.bytes.byteLength;
      }
      const ms3Capn = Math.max(0.005, (performance.now() - t3C0) / 20);
      updateBenchCard('b3', ms3Json, ms3Capn, '0 MB heap vs +14.2 MB');

      // 4. 10,000 Cyclic Ring Nodes (ref(() => RingNode))
      const N_RING = 10_000;
      const RING_CLUSTER = 50;
      const RingNode: any = defineStruct('RingNode', {
        id: u32,
        weight: f64,
        next: ref(() => RingNode),
        prev: ref(() => RingNode),
      });
      const jsRing: any[] = Array.from({ length: N_RING }, (_, i) => ({
        id: i,
        weight: i * 1.25,
        next: null,
        prev: null,
      }));
      for (let i = 0; i < N_RING; i++) {
        const base = Math.floor(i / RING_CLUSTER) * RING_CLUSTER;
        const off = i % RING_CLUSTER;
        jsRing[i].next = jsRing[base + ((off + 1) % RING_CLUSTER)];
        jsRing[i].prev = jsRing[base + ((off + RING_CLUSTER - 1) % RING_CLUSTER)];
      }
      const capnRingBytes = RingNode.pack(jsRing);
      const ITERS4 = 10;
      const t4J0 = performance.now();
      for (let it = 0; it < ITERS4; it++) {
        const cloned = structuredClone(jsRing);
        for (let c = 0; c < N_RING; c += RING_CLUSTER) {
          let cur = cloned[c];
          for (let j = 0; j < RING_CLUSTER; j++) {
            sink += cur.weight;
            cur = cur.next;
          }
        }
      }
      const ms4Json = (performance.now() - t4J0) / ITERS4;
      const t4C0 = performance.now();
      for (let it = 0; it < ITERS4; it++) {
        const view = RingNode.array(capnRingBytes);
        let cur = view.cursor(0);
        for (let c = 0; c < N_RING; c += RING_CLUSTER) {
          cur = view.seek(c);
          for (let j = 0; j < RING_CLUSTER; j++) {
            sink += cur.weight;
            cur = cur.next;
          }
        }
      }
      const ms4Capn = Math.max(0.005, (performance.now() - t4C0) / ITERS4);
      updateBenchCard('b4', ms4Json, ms4Capn, '0 MB heap, JSON throws!');
      if (btn) {
        btn.disabled = false;
        btn.textContent = 'Re-Run Live Benchmark';
      }
      if (sink === -999999) console.log(sink);
    }, 20);
  }

  function updateBenchCard(prefix: string, msJson: number, msCapn: number, note: string) {
    const jsonEl = document.getElementById(`cs-${prefix}-json`);
    const capnEl = document.getElementById(`cs-${prefix}-capn`);
    const barEl = document.getElementById(`cs-${prefix}-bar`);
    const speedEl = document.getElementById(`cs-${prefix}-speedup`);
    const speedup = msJson / msCapn;
    if (jsonEl) jsonEl.textContent = `${msJson.toFixed(2)} ms`;
    if (capnEl) capnEl.textContent = `${msCapn.toFixed(2)} ms`;
    if (barEl) barEl.style.width = `${Math.max(1.5, Math.min(100, (msCapn / msJson) * 100))}%`;
    if (speedEl) speedEl.textContent = `${speedup.toFixed(1)}x faster (${note})`;
  }

  document.getElementById('cs-run-bench')?.addEventListener('click', runBenchmarks);

  // --- TAB 2: LIVE BINARY MUTATOR & INSPECTOR ---
  const User = defineStruct('User', {
    id: u32,
    name: str,
    scores: slice(u32),
  });

  const initialUsers = pack(User, [
    { id: 1, name: 'Ada Lovelace', scores: [10, 20, 30] },
    { id: 2, name: 'Alan Turing', scores: [40, 50] },
  ]);
  const usersView = User.array(initialUsers);
  let nextId = 3;

  function formatHexDump(bytes: Uint8Array, rowCount: number, stride: number): string {
    const tableBytes = rowCount * stride;
    const lines: string[] = [];
    lines.push(
      `// Fixed #[repr(C)] Table: 0x0000..0x${tableBytes.toString(16).padStart(4, '0')} (${tableBytes} B) | Tail Arena: 0x${tableBytes.toString(16).padStart(4, '0')}..0x${bytes.byteLength.toString(16).padStart(4, '0')} (${Math.max(0, bytes.byteLength - tableBytes)} B)`
    );
    for (let off = 0; off < bytes.byteLength; off += 16) {
      const hexParts: string[] = [];
      let ascii = '';
      for (let i = 0; i < 16; i++) {
        if (off + i < bytes.byteLength) {
          const b = bytes[off + i];
          hexParts.push(b.toString(16).padStart(2, '0'));
          ascii += b >= 32 && b <= 126 ? String.fromCharCode(b) : '.';
        } else {
          hexParts.push('  ');
          ascii += ' ';
        }
      }
      const region = off < tableBytes ? 'TBL ' : 'TAIL';
      lines.push(
        `${region} 0x${off.toString(16).padStart(4, '0')}: ${hexParts.slice(0, 8).join(' ')}  ${hexParts.slice(8).join(' ')}  |${ascii}|`
      );
    }
    return lines.join('\n');
  }

  function renderMutator(actionLabel: string) {
    const lenEl = document.getElementById('cs-st-len');
    const strideEl = document.getElementById('cs-st-stride');
    const bytesEl = document.getElementById('cs-st-bytes');
    const fragEl = document.getElementById('cs-st-frag');
    const actEl = document.getElementById('cs-st-action');
    const listEl = document.getElementById('cs-rows-editor');
    const hexEl = document.getElementById('cs-hex-view');

    const rawSlice = new Uint8Array(
      usersView.buffer,
      usersView.byteOffset,
      Math.max(usersView.byteLength, (usersView as any)._tl ? (usersView as any)._tl - usersView.byteOffset : usersView.byteLength)
    );

    if (lenEl) lenEl.textContent = String(usersView.length);
    if (strideEl) strideEl.textContent = `${usersView.stride} B`;
    if (bytesEl) bytesEl.textContent = `${rawSlice.byteLength} B`;
    if (fragEl) fragEl.textContent = `${(usersView.compactionRatio * 100).toFixed(1)}%`;
    if (actEl) actEl.textContent = actionLabel;
    if (hexEl) hexEl.textContent = formatHexDump(rawSlice, usersView.length, usersView.stride);

    if (listEl) {
      listEl.innerHTML = '';
      for (let i = 0; i < usersView.length; i++) {
        const u = usersView.at(i);
        const rowDiv = document.createElement('div');
        rowDiv.className = 'cs-row-item';

        const idSpan = document.createElement('span');
        idSpan.innerHTML = `<code>#${u.id}</code>`;

        const nameInput = document.createElement('input');
        nameInput.value = u.name;
        nameInput.title = 'Edit row.name (in-place when <= current UTF-8 length, tail-append when longer)';
        nameInput.addEventListener('change', () => {
          const prevDead = (usersView as any)._dead ?? 0;
          const prevLen = new TextEncoder().encode(usersView.at(i).name).byteLength;
          const nextLen = new TextEncoder().encode(nameInput.value).byteLength;
          usersView.at(i).name = nameInput.value;
          const nextDead = (usersView as any)._dead ?? 0;
          renderMutator(
            nextLen <= prevLen
              ? `row[${i}].name overwritten in-place (0 allocs)`
              : nextDead === prevDead
                ? `row[${i}].name extended in-place at tail tip (0 dead bytes)`
                : `row[${i}].name bump-allocated in tail arena`
          );
        });

        const scoresInput = document.createElement('input');
        scoresInput.value = Array.from(u.scores).join(', ');
        scoresInput.title = 'Comma-separated u32 slice values';
        scoresInput.addEventListener('change', () => {
          const nums = scoresInput.value
            .split(',')
            .map((s) => parseInt(s.trim(), 10))
            .filter((n) => !Number.isNaN(n) && n >= 0);
          usersView.at(i).set({ scores: nums });
          renderMutator(`Updated row[${i}].scores (${nums.length} u32 items)`);
        });

        rowDiv.append(idSpan, nameInput, scoresInput);
        listEl.appendChild(rowDiv);
      }
    }
  }

  document.getElementById('cs-btn-push')?.addEventListener('click', () => {
    const id = nextId++;
    usersView.push({ id, name: `Engineer_${id}`, scores: [id * 10, id * 20] });
    renderMutator(`users.push({ id: ${id}, ... })`);
  });

  document.getElementById('cs-btn-pop')?.addEventListener('click', () => {
    const popped = usersView.pop();
    renderMutator(popped ? `users.pop() -> #${popped.id}` : 'users.pop() (empty)');
  });

  document.getElementById('cs-btn-compact')?.addEventListener('click', () => {
    const packed = usersView.compact();
    renderMutator(`users.compact() -> ${packed.byteLength} B tight wire buffer`);
  });

  renderMutator('Initial 2-row binary buffer');

  // --- TAB 3: RUST #[repr(C)] CODEGEN ---
  const OutHit = defineStruct('OutHit', {
    fid: u32,
    lat: f64,
    lon: f64,
    tStart: f64,
    tEnd: f64,
    fids: fixedArray(u32, 8),
  });

  const PaddedAlignment = defineStruct('PaddedAlignment', {
    big: u64,
    flag: u8,
    code: u16,
    samples: slice(i32),
  });
  const GraphNode: any = defineStruct('GraphNode', {
    id: u32,
    weight: f64,
    label: str,
    next: ref(() => GraphNode),
    children: slice(() => GraphNode),
  });

  const presets: Record<string, { ts: string; structs: any[] }> = {
    telemetry: {
      ts: `const Waypoint = defineStruct('Waypoint', {
  lat: f32, // offset 0, size 4
  lon: f32, // offset 4, size 4
}); // size: 8, align: 4

const TelemetryRow = defineStruct('TelemetryRow', {
  flightId: u32,                // offset 0
  squawk: u16,                  // offset 4
  flags: u16,                   // offset 6
  lat: f32,                     // offset 8
  lon: f32,                     // offset 12
  altBaro: i32,                 // offset 16
  groundSpeed: f32,             // offset 20
  callsign: str,                // offset 24 ([u32 relOffset, u32 len])
  route: str,                   // offset 32 ([u32 relOffset, u32 len])
  waypoints: slice(Waypoint),   // offset 40 ([u32 relOffset, u32 len])
}); // size: 48, align: 4`,
      structs: [Waypoint, TelemetryRow],
    },
    graph: {
      ts: `const GraphNode: any = defineStruct('GraphNode', {
  id: u32,                           // offset 0, size 4 (+4B padding before f64)
  weight: f64,                       // offset 8, size 8
  label: str,                        // offset 16, size 8 (CapnStr)
  next: ref(() => GraphNode),        // offset 24, size 8 (CapnRef<GraphNode>)
  children: slice(() => GraphNode),  // offset 32, size 8 (CapnSlice<GraphNode>)
}); // size: 40, align: 8`,
      structs: [GraphNode],
    },
    spdsample: {
      ts: `const SpdSample = defineStruct('SpdSample', {
  t: u32,    // offset 0 (4B padding auto-inserted after t)
  val: f64,  // offset 8, align 8
  id: u32,   // offset 16 (4B trailing padding to align stride to 8)
}); // size: 24, align: 8

const OutHit = defineStruct('OutHit', {
  fid: u32,                  // offset 0 (4B padding before lat)
  lat: f64,                  // offset 8
  lon: f64,                  // offset 16
  tstart: f64,               // offset 24
  tend: f64,                 // offset 32
  fids: fixedArray(u32, 8),  // offset 40..72
}); // size: 72, align: 8`,
      structs: [SpdSample, OutHit],
    },
    padded: {
      ts: `const PaddedAlignment = defineStruct('PaddedAlignment', {
  big: u64,            // offset 0, align 8
  flag: u8,            // offset 8, align 1 (+1B pad before code)
  code: u16,           // offset 10, align 2
  samples: slice(i32), // offset 12, align 4 (8B CapnSlice<i32> + 4B tail pad)
}); // size: 24, align: 8`,
      structs: [PaddedAlignment],
    },
  };

  const selectEl = document.getElementById('cs-schema-select') as HTMLSelectElement | null;

  function renderRustCodegen() {
    const key = selectEl?.value ?? 'telemetry';
    const preset = presets[key] ?? presets.telemetry;
    const tsEl = document.getElementById('cs-ts-schema');
    const rsEl = document.getElementById('cs-rust-output');
    if (tsEl) tsEl.textContent = preset.ts;
    if (rsEl) rsEl.textContent = toRustReprC(preset.structs);
  }

  selectEl?.addEventListener('change', renderRustCodegen);
  renderRustCodegen();
</script>
