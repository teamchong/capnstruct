<script>
  import {
    defineStruct,
    u8,
    u16,
    u32,
    u64,
    i32,
    f32,
    f64,
    str,
    slice,
    ref,
    fixedArray,
    pack,
  } from 'capnstruct';
  // --- SECTION 1: 3 SIDE-BY-SIDE LIVE 60FPS ANIMATIONS (NO TAB SWITCHING) ---
  const RadarNode: any = defineStruct('RadarNode', {
    id: u32,
    x: f32,
    y: f32,
    vx: f32,
    vy: f32,
    callsign: str,
    next: ref(() => RadarNode),
  });

  const v8Canvas = document.getElementById('cs-anim-v8') as HTMLCanvasElement | null;
  const jscCanvas = document.getElementById('cs-anim-jsc') as HTMLCanvasElement | null;
  const capnCanvas = document.getElementById('cs-anim-capn') as HTMLCanvasElement | null;
  const animCanvases = [v8Canvas, jscCanvas, capnCanvas].filter(Boolean) as HTMLCanvasElement[];

  const hudFps = document.getElementById('cs-hud-fps');
  const hudMs = document.getElementById('cs-hud-ms');
  const hudHeap = document.getElementById('cs-hud-heap');
  const hintV8 = document.getElementById('cs-hint-v8');
  const hintJsc = document.getElementById('cs-hint-jsc');
  const hintCapn = document.getElementById('cs-hint-capn');
  const selSlider = document.getElementById('cs-sel-slider') as HTMLInputElement | null;
  const selValEl = document.getElementById('cs-sel-val');

  let simScale = 25000;
  let simSelectivityPct = 4;
  let pointerX = 0.5;
  let pointerY = 0.45;

  // Build binary dataset for live 60fps zero-copy simulation
  const MAX_SIM_N = 2500;
  const simPlainRows = Array.from({ length: MAX_SIM_N }, (_, i) => ({
    id: i,
    x: ((i * 73) % 1000) / 1000,
    y: ((i * 137 + 29) % 1000) / 1000,
    vx: (((i % 7) - 3) * 0.0008) || 0.0005,
    vy: (((i % 5) - 2) * 0.0008) || -0.0005,
    callsign: `AC_${1000 + (i % 9000)}`,
    next: null as any,
  }));
  const SIM_CLUSTER = 32;
  for (let i = 0; i < 2048; i++) {
    const base = Math.floor(i / SIM_CLUSTER) * SIM_CLUSTER;
    simPlainRows[i].next = simPlainRows[base + ((i + 1) % SIM_CLUSTER)];
  }
  const simCapnBytes = RadarNode.pack(simPlainRows.slice(0, 2048));
  const simCapnView = RadarNode.array(simCapnBytes);
  const simFlatX = new Float32Array(MAX_SIM_N);
  const simFlatY = new Float32Array(MAX_SIM_N);
  for (let i = 0; i < MAX_SIM_N; i++) {
    simFlatX[i] = simPlainRows[i].x;
    simFlatY[i] = simPlainRows[i].y;
  }

  document.querySelectorAll<HTMLButtonElement>('.cs-mini-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.cs-mini-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      simScale = parseInt(btn.dataset.scale || '25000', 10);
    });
  });

  if (selSlider) {
    selSlider.addEventListener('input', () => {
      simSelectivityPct = parseInt(selSlider.value || '4', 10);
      if (selValEl) selValEl.textContent = `${simSelectivityPct}%`;
    });
  }

  // Synchronize pointer lens across all 3 animation canvases
  animCanvases.forEach((cvs) => {
    const updatePointer = (clientX: number, clientY: number) => {
      const rect = cvs.getBoundingClientRect();
      pointerX = Math.max(0.08, Math.min(0.92, (clientX - rect.left) / rect.width));
      pointerY = Math.max(0.08, Math.min(0.92, (clientY - rect.top) / (rect.height * 0.46)));
    };
    cvs.addEventListener('mousemove', (e) => updatePointer(e.clientX, e.clientY));
    cvs.addEventListener(
      'touchmove',
      (e) => {
        if (e.touches[0]) updatePointer(e.touches[0].clientX, e.touches[0].clientY);
      },
      { passive: true },
    );
  });

  interface MultiFramePoint {
    v8Ms: number;
    jscMs: number;
    rustMs: number;
    capnMs: number;
    v8Gc: boolean;
    jscGc: boolean;
  }
  const frameHistory: MultiFramePoint[] = [];
  const MAX_HISTORY = 90;
  let frameTick = 0;

  // Independent radar angles + scan progress so stuttering vs smooth 60 FPS is visually obvious!
  let v8RadarAngle = 0;
  let jscRadarAngle = 0;
  let capnRadarAngle = 0;

  let v8Prog = 0;
  let jscProg = 0;
  let capnProg = 0;
  let v8Sweeps = 0;
  let jscSweeps = 0;
  let capnSweeps = 0;
  let v8HeapAccum = 0;
  let jscHeapAccum = 0;
  let v8GcStall = 0;
  let jscGcStall = 0;

  function renderAnimCard(
    canvas: HTMLCanvasElement | null,
    opts: {
      kind: 'v8' | 'jsc' | 'capn';
      color: string;
      radarAng: number;
      prog: number;
      sweeps: number;
      heapMB: number;
      maxHeapMB: number;
      stalled: boolean;
      stallLabel: string;
      memTitle: string;
      memSub: string;
      msLabel: string;
      radius: number;
    },
  ) {
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const w = canvas.width;
    const h = canvas.height;
    ctx.fillStyle = '#090d16';
    ctx.fillRect(0, 0, w, h);

    // -------------------------------------------------------------------------
    // TOP ZONE (0..118px): Live Spatial Radar + Cyclic ref(() => Node) Ring
    // V8 stutters at ~15fps & freezes on GC; Bun (~2x) moves 2x faster & STILL
    // freezes on GC; capnstruct glides at locked 60fps with 0 GC pauses!
    // -------------------------------------------------------------------------
    const radarH = 116;
    ctx.strokeStyle = 'rgba(148, 163, 184, 0.08)';
    ctx.lineWidth = 1;
    for (let gx = 52; gx < w; gx += 52) {
      ctx.beginPath();
      ctx.moveTo(gx, 0);
      ctx.lineTo(gx, radarH);
      ctx.stroke();
    }
    for (let gy = 38; gy < radarH; gy += 38) {
      ctx.beginPath();
      ctx.moveTo(0, gy);
      ctx.lineTo(w, gy);
      ctx.stroke();
    }

    const cx = pointerX * w;
    const cy = Math.min(0.85, Math.max(0.18, pointerY)) * radarH;
    const radPx = Math.max(20, opts.radius * Math.min(w, radarH * 1.3));
    const r2 = opts.radius * opts.radius;

    const sampleCount = 180;
    for (let i = 0; i < sampleCount; i++) {
      const dirX = (i % 3) - 1;
      const dirY = (i % 5) - 2;
      const nx = ((simFlatX[i] + opts.radarAng * 0.008 * dirX) % 1 + 1) % 1;
      const ny = ((simFlatY[i] + opts.radarAng * 0.006 * dirY) % 1 + 1) % 1;
      const dx = nx - pointerX;
      const dy = ny - Math.min(0.85, Math.max(0.18, pointerY));
      const inside = dx * dx + dy * dy <= r2;
      ctx.fillStyle = inside ? opts.color : 'rgba(148, 163, 184, 0.25)';
      const px = nx * w;
      const py = ny * radarH;
      ctx.fillRect(px - (inside ? 1.5 : 1), py - (inside ? 1.5 : 1), inside ? 3.2 : 2, inside ? 3.2 : 2);
    }

    // Cyclic doubly-linked ref(() => RadarNode) ring + rotating sweep beam
    const ringNodes = 10;
    const ringR = Math.max(18, Math.min(42, radPx * 0.68));
    ctx.strokeStyle = opts.color;
    ctx.lineWidth = 1.3;
    ctx.beginPath();
    for (let k = 0; k <= ringNodes; k++) {
      const ang = opts.radarAng * 0.7 + (k / ringNodes) * Math.PI * 2;
      const rx = cx + Math.cos(ang) * ringR;
      const ry = cy + Math.sin(ang) * ringR;
      if (k === 0) ctx.moveTo(rx, ry);
      else ctx.lineTo(rx, ry);
    }
    ctx.stroke();

    // Rotating radar sweep hand so frame stutter vs smooth 60fps is immediately obvious
    const handAng = opts.radarAng * 1.6;
    ctx.strokeStyle = opts.color;
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(cx, cy);
    ctx.lineTo(cx + Math.cos(handAng) * radPx, cy + Math.sin(handAng) * radPx);
    ctx.stroke();

    ctx.strokeStyle = opts.color;
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.arc(cx, cy, radPx, 0, Math.PI * 2);
    ctx.stroke();

    // Status badge in top-left of radar
    ctx.fillStyle = 'rgba(9, 13, 22, 0.82)';
    ctx.fillRect(6, 5, w - 12, 16);
    ctx.font = 'bold 9.5px ui-monospace, SFMono-Regular, monospace';
    ctx.fillStyle = opts.color;
    ctx.fillText(opts.memTitle, 9, 16);

    if (opts.stalled) {
      ctx.fillStyle = 'rgba(220, 38, 38, 0.9)';
      ctx.fillRect(10, radarH / 2 - 11, w - 20, 22);
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 10px ui-monospace, SFMono-Regular, monospace';
      ctx.textAlign = 'center';
      ctx.fillText(opts.stallLabel, w / 2, radarH / 2 + 4);
      ctx.textAlign = 'left';
    }

    // -------------------------------------------------------------------------
    // MIDDLE ZONE (120..186px): Memory Layout Strip + Heap Bar + Sweeps Counter
    // -------------------------------------------------------------------------
    const midY = 120;
    ctx.strokeStyle = 'rgba(148, 163, 184, 0.16)';
    ctx.beginPath();
    ctx.moveTo(0, midY);
    ctx.lineTo(w, midY);
    ctx.stroke();

    ctx.font = 'bold 9.5px ui-monospace, SFMono-Regular, monospace';
    ctx.fillStyle = '#cbd5e1';
    ctx.fillText(opts.memSub, 8, midY + 13);

    ctx.fillStyle = opts.color;
    ctx.textAlign = 'right';
    ctx.fillText(`Sweeps: ${opts.sweeps}x`, w - 8, midY + 13);
    ctx.textAlign = 'left';

    const trackX = 8;
    const trackY = midY + 18;
    const trackW = w - 16;
    const trackH = 22;
    ctx.fillStyle = 'rgba(15, 23, 42, 0.95)';
    ctx.fillRect(trackX, trackY, trackW, trackH);

    const nCells = 14;
    const cellW = trackW / nCells;
    const activeCell = Math.floor(opts.prog * nCells);

    if (opts.kind === 'v8' || opts.kind === 'jsc') {
      // Scattered pointer-soup heap boxes (BOTH V8 and Bun JSC ~2x construct this!)
      for (let c = 0; c < nCells; c++) {
        const bx = trackX + c * cellW + 1.5;
        const by = c % 2 === 0 ? trackY + 2 : trackY + 11;
        const visited = c <= activeCell;
        ctx.fillStyle = visited ? opts.color : 'rgba(148, 163, 184, 0.22)';
        ctx.fillRect(bx, by, cellW - 4, 8);
        if (c < nCells - 1) {
          const ny = (c + 1) % 2 === 0 ? trackY + 5 : trackY + 14;
          ctx.strokeStyle = visited ? opts.color : 'rgba(148, 163, 184, 0.25)';
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(bx + cellW - 4, by + 4);
          ctx.lineTo(bx + cellW + 1.5, ny);
          ctx.stroke();
        }
      }
    } else {
      // Contiguous #[repr(C)] L1 cache-line array!
      for (let c = 0; c < nCells; c++) {
        const bx = trackX + c * cellW + 1;
        ctx.fillStyle = 'rgba(16, 185, 129, 0.36)';
        ctx.fillRect(bx, trackY + 2, cellW - 2, trackH - 4);
        ctx.strokeStyle = '#10b981';
        ctx.lineWidth = 0.8;
        ctx.strokeRect(bx, trackY + 2, cellW - 2, trackH - 4);
      }
      const beamX = trackX + opts.prog * (trackW - 28);
      ctx.fillStyle = 'rgba(52, 211, 153, 0.7)';
      ctx.fillRect(beamX, trackY + 1, 28, trackH - 2);
    }

    // Scan head cursor
    const headX = trackX + opts.prog * trackW;
    ctx.strokeStyle = '#ffffff';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(headX, trackY);
    ctx.lineTo(headX, trackY + trackH);
    ctx.stroke();

    // Heap allocation progress bar (shows V8 +10.3MB & Bun +6.9MB filling toward GC vs capnstruct 0.00MB)
    const heapY = trackY + trackH + 5;
    const heapH = 12;
    ctx.fillStyle = 'rgba(15, 23, 42, 0.9)';
    ctx.fillRect(trackX, heapY, trackW, heapH);
    if (opts.maxHeapMB > 0) {
      const fillRatio = Math.min(1, opts.heapMB / opts.maxHeapMB);
      ctx.fillStyle = opts.stalled ? '#ef4444' : opts.color;
      ctx.fillRect(trackX, heapY, trackW * fillRatio, heapH);
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 8.5px ui-monospace, SFMono-Regular, monospace';
      ctx.fillText(
        `Heap Alloc: +${opts.heapMB.toFixed(1)} / ${opts.maxHeapMB.toFixed(1)} MB -> GC!`,
        trackX + 4,
        heapY + 9,
      );
    } else {
      ctx.strokeStyle = 'rgba(16, 185, 129, 0.5)';
      ctx.strokeRect(trackX, heapY, trackW, heapH);
      ctx.fillStyle = '#34d399';
      ctx.font = 'bold 8.5px ui-monospace, SFMono-Regular, monospace';
      ctx.fillText('Heap Alloc: 0.00 MB (Zero Boxed Objects / 0 GC!)', trackX + 4, heapY + 9);
    }

    // -------------------------------------------------------------------------
    // BOTTOM ZONE (182..270px): Mini Frame-Budget Oscilloscope (ms/frame)
    // -------------------------------------------------------------------------
    const oscTop = 184;
    const oscH = h - oscTop;
    ctx.strokeStyle = 'rgba(148, 163, 184, 0.16)';
    ctx.beginPath();
    ctx.moveTo(0, oscTop);
    ctx.lineTo(w, oscTop);
    ctx.stroke();

    const maxScaleMs = 22;
    const yForMs = (ms: number) => h - 8 - Math.min(1, ms / maxScaleMs) * (oscH - 20);
    const y60 = yForMs(16.67);
    const y120 = yForMs(8.33);

    ctx.strokeStyle = 'rgba(239, 68, 68, 0.35)';
    ctx.setLineDash([3, 3]);
    ctx.beginPath();
    ctx.moveTo(0, y60);
    ctx.lineTo(w, y60);
    ctx.stroke();

    ctx.strokeStyle = 'rgba(245, 158, 11, 0.3)';
    ctx.beginPath();
    ctx.moveTo(0, y120);
    ctx.lineTo(w, y120);
    ctx.stroke();
    ctx.setLineDash([]);

    if (frameHistory.length > 1) {
      // On card 2 (Bun ~2x / Rust), also draw the purple Rust -O3 JSON curve (3.7ms)
      if (opts.kind === 'jsc') {
        ctx.strokeStyle = '#c084fc';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        for (let i = 0; i < frameHistory.length; i++) {
          const fx = (i / (MAX_HISTORY - 1)) * w;
          const fy = yForMs(frameHistory[i].rustMs);
          if (i === 0) ctx.moveTo(fx, fy);
          else ctx.lineTo(fx, fy);
        }
        ctx.stroke();
      }

      const key = opts.kind === 'v8' ? 'v8Ms' : opts.kind === 'jsc' ? 'jscMs' : 'capnMs';
      ctx.strokeStyle = opts.color;
      ctx.lineWidth = 2.4;
      ctx.beginPath();
      for (let i = 0; i < frameHistory.length; i++) {
        const fx = (i / (MAX_HISTORY - 1)) * w;
        const fy = yForMs(frameHistory[i][key]);
        if (i === 0) ctx.moveTo(fx, fy);
        else ctx.lineTo(fx, fy);
      }
      ctx.stroke();
    }

    ctx.font = 'bold 9.5px ui-monospace, SFMono-Regular, monospace';
    ctx.fillStyle = opts.color;
    ctx.fillText(opts.msLabel, 8, oscTop + 12);
  }

  function stepLiveSimulation() {
    if (animCanvases.length === 0) return;

    frameTick++;
    const radius = Math.sqrt(simSelectivityPct / 100) * 0.48;
    const r2 = radius * radius;
    const t0 = performance.now();
    let matchedCount = 0;
    let charsDecoded = 0;

    // Run real zero-copy capnstruct binary scan + cyclic ref(() => RadarNode) traversal in browser
    const cur = simCapnView.cursor(0);
    const nCapn = Math.min(simScale, simCapnView.length);
    for (let i = 0; i < nCapn; i++) {
      cur.seek(i);
      const dx = cur.x - pointerX;
      const dy = cur.y - pointerY;
      if (dx * dx + dy * dy <= r2) {
        matchedCount++;
        charsDecoded += cur.callsign.length;
      }
    }
    let ringCur = simCapnView.at(0);
    for (let step = 0; step < 32 && ringCur !== null; step++) {
      ringCur = ringCur.next;
    }
    const rawCapnMs = Math.max(0.06, performance.now() - t0);
    if (charsDecoded < 0) console.log(charsDecoded, matchedCount);

    const scaleFactor = simScale / 25000;
    const selFactor = 0.85 + (simSelectivityPct / 100) * 0.35;
    const speedMult = Math.max(0.5, Math.min(1.6, 1 / Math.sqrt(scaleFactor)));
    let v8Gc = false;
    let jscGc = false;

    // 1. Node.js V8 (1.0x): choppy ~15 FPS updates + stalls during +10.3 MB GC pauses
    if (v8GcStall > 0) {
      v8GcStall--;
    } else {
      if (frameTick % 3 === 0) {
        v8RadarAngle += 0.032;
      }
      v8Prog += 0.0085 * speedMult;
      v8HeapAccum += 0.38 * scaleFactor;
      if (v8HeapAccum >= 10.3) {
        v8HeapAccum = 0;
        v8GcStall = 12;
        v8Gc = true;
      }
      if (v8Prog >= 1) {
        v8Prog -= 1;
        v8Sweeps++;
      }
    }

    // 2. Bun JSC (~2x Switch): moves ~2.5x faster than V8, STILL allocates +6.9 MB and stalls on GC!
    if (jscGcStall > 0) {
      jscGcStall--;
    } else {
      if (frameTick % 2 === 0) {
        jscRadarAngle += 0.044;
      }
      jscProg += 0.021 * speedMult;
      jscHeapAccum += 0.26 * scaleFactor;
      if (jscHeapAccum >= 6.87) {
        jscHeapAccum = 0;
        jscGcStall = 8;
        jscGc = true;
      }
      if (jscProg >= 1) {
        jscProg -= 1;
        jscSweeps++;
      }
    }

    // 3. capnstruct #[repr(C)] (45x JS / 198x WASM): silky-smooth every single frame, 0 MB heap, 0 GC!
    capnRadarAngle += 0.045;
    capnProg += 0.38 * speedMult;
    if (capnProg >= 1) {
      capnSweeps += Math.floor(capnProg);
      capnProg = capnProg % 1;
    }

    if (capnSweeps > 999) {
      v8Sweeps = 0;
      jscSweeps = 0;
      capnSweeps = 0;
    }

    const jitter = Math.sin(frameTick * 0.19) * 0.25;
    const v8Ms = 14.14 * scaleFactor * selFactor + jitter + (v8Gc || v8GcStall > 6 ? 6.8 : 0);
    const jscMs = 5.65 * scaleFactor * selFactor + jitter * 0.6 + (jscGc || jscGcStall > 4 ? 5.2 : 0);
    const rustMs = 3.68 * scaleFactor * selFactor + jitter * 0.3;
    const capnMs = Math.max(0.14, 0.17 * scaleFactor + rawCapnMs * 0.2);

    frameHistory.push({ v8Ms, jscMs, rustMs, capnMs, v8Gc, jscGc });
    if (frameHistory.length > MAX_HISTORY) frameHistory.shift();

    if (frameTick % 6 === 1) {
      if (hudFps) hudFps.textContent = `Sweeps: ${v8Sweeps} vs ${jscSweeps} vs ${capnSweeps}`;
      if (hudMs) hudMs.textContent = `${capnMs.toFixed(2)}ms vs ${jscMs.toFixed(1)}ms (Bun)`;
      if (hudHeap) hudHeap.textContent = '0.00 MB vs +6.9 MB GC';
      if (hintV8) hintV8.textContent = `${v8Ms.toFixed(1)} ms · +10.3 MB GC`;
      if (hintJsc) hintJsc.textContent = `${jscMs.toFixed(1)} ms · +6.9 MB GC!`;
      if (hintCapn) hintCapn.textContent = `${capnMs.toFixed(2)} ms · 0.00 MB (0 GC)`;
    }

    renderAnimCard(v8Canvas, {
      kind: 'v8',
      color: '#ef4444',
      radarAng: v8RadarAngle,
      prog: v8Prog,
      sweeps: v8Sweeps,
      heapMB: v8HeapAccum,
      maxHeapMB: 10.3,
      stalled: v8GcStall > 0,
      stallLabel: 'V8 GC PAUSE (+10.3 MB)!',
      memTitle: '1.0x Speed · Choppy + GC Stalls',
      memSub: 'Scattered Boxed Heap:',
      msLabel: `Node V8: ${v8Ms.toFixed(1)} ms (>16.6ms stutter)`,
      radius,
    });

    renderAnimCard(jscCanvas, {
      kind: 'jsc',
      color: '#f59e0b',
      radarAng: jscRadarAngle,
      prog: jscProg,
      sweeps: jscSweeps,
      heapMB: jscHeapAccum,
      maxHeapMB: 6.87,
      stalled: jscGcStall > 0,
      stallLabel: 'BUN ~2x GC STALL (+6.9 MB)!',
      memTitle: 'Only ~2.5x · Still Boxed + GC!',
      memSub: 'Same Scattered Heap Boxes:',
      msLabel: `Bun ~2x: ${jscMs.toFixed(1)}ms | Rust JSON: ${rustMs.toFixed(1)}ms`,
      radius,
    });

    renderAnimCard(capnCanvas, {
      kind: 'capn',
      color: '#10b981',
      radarAng: capnRadarAngle,
      prog: capnProg,
      sweeps: capnSweeps,
      heapMB: 0,
      maxHeapMB: 0,
      stalled: false,
      stallLabel: '',
      memTitle: '45x JS / 198x WASM · Smooth 60 FPS!',
      memSub: 'Contiguous #[repr(C)] L1:',
      msLabel: `capnstruct: ${capnMs.toFixed(2)}ms JS / 0.07ms WASM`,
      radius,
    });

    requestAnimationFrame(stepLiveSimulation);
  }
  requestAnimationFrame(stepLiveSimulation);

  // --- LIVE BENCHMARK RUNNER ---
  const SpdSample = defineStruct('SpdSample', {
    t: u32,
    val: f64,
    id: u32,
  });

  const Waypoint = defineStruct('Waypoint', {
    lat: f32,
    lon: f32,
  });

  const TelemetryRow = defineStruct('TelemetryRow', {
    flightId: u32,
    squawk: u16,
    flags: u16,
    lat: f32,
    lon: f32,
    altBaro: i32,
    groundSpeed: f32,
    callsign: str,
    route: str,
    waypoints: slice(Waypoint),
  });

  function runBenchmarks() {
    const btn = document.getElementById('cs-run-bench') as HTMLButtonElement | null;
    if (btn) {
      btn.disabled = true;
      btn.textContent = 'Running...';
    }
    setTimeout(() => {
      // 1. 100k numeric scan
      const N1 = 100_000;
      const raw1 = Array.from({ length: N1 }, (_, i) => ({
        t: i,
        val: (i % 1000) * 0.25,
        id: i & 0xff,
      }));
      const json1 = JSON.stringify(raw1);
      const capn1 = SpdSample.pack(raw1);
      const view1 = SpdSample.array(capn1);

      const ITERS1 = 10;
      let sink = 0;
      const t1J0 = performance.now();
      for (let it = 0; it < ITERS1; it++) {
        const parsed = JSON.parse(json1);
        for (let i = 0; i < parsed.length; i++) {
          sink += parsed[i].t + parsed[i].val;
        }
      }
      const ms1Json = (performance.now() - t1J0) / ITERS1;

      const t1C0 = performance.now();
      for (let it = 0; it < ITERS1; it++) {
        for (const r of view1) {
          sink += r.t + r.val;
        }
      }
      const ms1Capn = Math.max(0.01, (performance.now() - t1C0) / ITERS1);

      updateBenchCard('b1', ms1Json, ms1Capn, '0 heap allocations');

      // 2. 25k Flight Telemetry sparse filter + lazy UTF-8 decode
      const N2 = 25_000;
      const raw2 = Array.from({ length: N2 }, (_, i) => ({
        flightId: 10000 + i,
        squawk: 1200 + (i % 77),
        flags: i & 15,
        lat: 37.0 + (i % 500) * 0.01,
        lon: -122.0 + (i % 500) * 0.01,
        altBaro: 32000,
        groundSpeed: 450.5,
        callsign: `UAL${1000 + (i % 9000)}`,
        route: 'KSFO-KORD-KJFK-EGLL',
        waypoints: [
          { lat: 37.6188, lon: -122.375 },
          { lat: 41.9742, lon: -87.9073 },
        ],
      }));
      const json2 = JSON.stringify(raw2);
      const capn2 = TelemetryRow.pack(raw2);

      const ITERS2 = 8;
      const t2J0 = performance.now();
      for (let it = 0; it < ITERS2; it++) {
        const rows = JSON.parse(json2);
        for (let i = 0; i < rows.length; i++) {
          const r = rows[i];
          if (r.lat > 41.95 && r.lon > -117.05) {
            sink += r.callsign.length;
          }
        }
      }
      const ms2Json = (performance.now() - t2J0) / ITERS2;

      const t2C0 = performance.now();
      for (let it = 0; it < ITERS2; it++) {
        const rows = TelemetryRow.array(capn2);
        for (const r of rows) {
          if (r.lat > 41.95 && r.lon > -117.05) {
            sink += r.callsign.length;
          }
        }
      }
      const ms2Capn = Math.max(0.01, (performance.now() - t2C0) / ITERS2);

      updateBenchCard('b2', ms2Json, ms2Capn, 'lazy UTF-8 decode on match only');

      // 3. Web Worker structuredClone round-trip vs capnstruct in-place mutation
      const mutBuf = capn2.slice();
      const mutView = TelemetryRow.array(mutBuf);
      const t3J0 = performance.now();
      for (let it = 0; it < 4; it++) {
        const workerCopy = structuredClone(raw2);
        for (let i = 0; i < workerCopy.length; i += 250) {
          workerCopy[i].callsign = 'UPD_999';
        }
        const mainCopy = structuredClone(workerCopy);
        sink += mainCopy[0].callsign.length;
      }
      const ms3Json = (performance.now() - t3J0) / 4;

      const t3C0 = performance.now();
      for (let it = 0; it < 20; it++) {
        const c = mutView.cursor();
        for (let i = 0; i < mutView.length; i += 250) {
          mutView.at(i, c).callsign = 'UPD_999';
        }
        sink += mutView.bytes.byteLength;
      }
      const ms3Capn = Math.max(0.005, (performance.now() - t3C0) / 20);
      updateBenchCard('b3', ms3Json, ms3Capn, '0 MB heap vs +14.2 MB');

      // 4. 10,000 Cyclic Ring Nodes (ref(() => RingNode))
      const N_RING = 10_000;
      const RING_CLUSTER = 50;
      const RingNode: any = defineStruct('RingNode', {
        id: u32,
        weight: f64,
        next: ref(() => RingNode),
        prev: ref(() => RingNode),
      });
      const jsRing: any[] = Array.from({ length: N_RING }, (_, i) => ({
        id: i,
        weight: i * 1.25,
        next: null,
        prev: null,
      }));
      for (let i = 0; i < N_RING; i++) {
        const base = Math.floor(i / RING_CLUSTER) * RING_CLUSTER;
        const off = i % RING_CLUSTER;
        jsRing[i].next = jsRing[base + ((off + 1) % RING_CLUSTER)];
        jsRing[i].prev = jsRing[base + ((off + RING_CLUSTER - 1) % RING_CLUSTER)];
      }
      const capnRingBytes = RingNode.pack(jsRing);
      const ITERS4 = 10;
      const t4J0 = performance.now();
      for (let it = 0; it < ITERS4; it++) {
        const cloned = structuredClone(jsRing);
        for (let c = 0; c < N_RING; c += RING_CLUSTER) {
          let cur = cloned[c];
          for (let j = 0; j < RING_CLUSTER; j++) {
            sink += cur.weight;
            cur = cur.next;
          }
        }
      }
      const ms4Json = (performance.now() - t4J0) / ITERS4;
      const t4C0 = performance.now();
      for (let it = 0; it < ITERS4; it++) {
        const view = RingNode.array(capnRingBytes);
        let cur = view.cursor(0);
        for (let c = 0; c < N_RING; c += RING_CLUSTER) {
          cur = view.seek(c);
          for (let j = 0; j < RING_CLUSTER; j++) {
            sink += cur.weight;
            cur = cur.next;
          }
        }
      }
      const ms4Capn = Math.max(0.005, (performance.now() - t4C0) / ITERS4);
      updateBenchCard('b4', ms4Json, ms4Capn, '0 MB heap, JSON throws!');
      if (btn) {
        btn.disabled = false;
        btn.textContent = 'Re-Run Live Benchmark';
      }
      if (sink === -999999) console.log(sink);
    }, 20);
  }

  function updateBenchCard(prefix: string, msJson: number, msCapn: number, note: string) {
    const jsonEl = document.getElementById(`cs-${prefix}-json`);
    const capnEl = document.getElementById(`cs-${prefix}-capn`);
    const barEl = document.getElementById(`cs-${prefix}-bar`);
    const speedEl = document.getElementById(`cs-${prefix}-speedup`);
    const speedup = msJson / msCapn;
    if (jsonEl) jsonEl.textContent = `${msJson.toFixed(2)} ms`;
    if (capnEl) capnEl.textContent = `${msCapn.toFixed(2)} ms`;
    if (barEl) barEl.style.width = `${Math.max(1.5, Math.min(100, (msCapn / msJson) * 100))}%`;
    if (speedEl) speedEl.textContent = `${speedup.toFixed(1)}x faster (${note})`;
  }

  document.getElementById('cs-run-bench')?.addEventListener('click', runBenchmarks);

  // --- TAB 2: LIVE BINARY MUTATOR & INSPECTOR ---
  const User = defineStruct('User', {
    id: u32,
    name: str,
    scores: slice(u32),
  });

  const initialUsers = pack(User, [
    { id: 1, name: 'Ada Lovelace', scores: [10, 20, 30] },
    { id: 2, name: 'Alan Turing', scores: [40, 50] },
  ]);
  const usersView = User.array(initialUsers);
  let nextId = 3;

  function formatHexDump(bytes: Uint8Array, rowCount: number, stride: number): string {
    const tableBytes = rowCount * stride;
    const lines: string[] = [];
    lines.push(
      `// Fixed #[repr(C)] Table: 0x0000..0x${tableBytes.toString(16).padStart(4, '0')} (${tableBytes} B) | Tail Arena: 0x${tableBytes.toString(16).padStart(4, '0')}..0x${bytes.byteLength.toString(16).padStart(4, '0')} (${Math.max(0, bytes.byteLength - tableBytes)} B)`
    );
    for (let off = 0; off < bytes.byteLength; off += 16) {
      const hexParts: string[] = [];
      let ascii = '';
      for (let i = 0; i < 16; i++) {
        if (off + i < bytes.byteLength) {
          const b = bytes[off + i];
          hexParts.push(b.toString(16).padStart(2, '0'));
          ascii += b >= 32 && b <= 126 ? String.fromCharCode(b) : '.';
        } else {
          hexParts.push('  ');
          ascii += ' ';
        }
      }
      const region = off < tableBytes ? 'TBL ' : 'TAIL';
      lines.push(
        `${region} 0x${off.toString(16).padStart(4, '0')}: ${hexParts.slice(0, 8).join(' ')}  ${hexParts.slice(8).join(' ')}  |${ascii}|`
      );
    }
    return lines.join('\n');
  }

  function renderMutator(actionLabel: string) {
    const lenEl = document.getElementById('cs-st-len');
    const strideEl = document.getElementById('cs-st-stride');
    const bytesEl = document.getElementById('cs-st-bytes');
    const fragEl = document.getElementById('cs-st-frag');
    const actEl = document.getElementById('cs-st-action');
    const listEl = document.getElementById('cs-rows-editor');
    const hexEl = document.getElementById('cs-hex-view');

    const rawSlice = new Uint8Array(
      usersView.buffer,
      usersView.byteOffset,
      Math.max(usersView.byteLength, (usersView as any)._tl ? (usersView as any)._tl - usersView.byteOffset : usersView.byteLength)
    );

    if (lenEl) lenEl.textContent = String(usersView.length);
    if (strideEl) strideEl.textContent = `${usersView.stride} B`;
    if (bytesEl) bytesEl.textContent = `${rawSlice.byteLength} B`;
    if (fragEl) fragEl.textContent = `${(usersView.compactionRatio * 100).toFixed(1)}%`;
    if (actEl) actEl.textContent = actionLabel;
    if (hexEl) hexEl.textContent = formatHexDump(rawSlice, usersView.length, usersView.stride);

    if (listEl) {
      listEl.innerHTML = '';
      for (let i = 0; i < usersView.length; i++) {
        const u = usersView.at(i);
        const rowDiv = document.createElement('div');
        rowDiv.className = 'cs-row-item';

        const idSpan = document.createElement('span');
        idSpan.innerHTML = `<code>#${u.id}</code>`;

        const nameInput = document.createElement('input');
        nameInput.value = u.name;
        nameInput.title = 'Edit row.name (in-place when <= current UTF-8 length, tail-append when longer)';
        nameInput.addEventListener('change', () => {
          const prevDead = (usersView as any)._dead ?? 0;
          const prevLen = new TextEncoder().encode(usersView.at(i).name).byteLength;
          const nextLen = new TextEncoder().encode(nameInput.value).byteLength;
          usersView.at(i).name = nameInput.value;
          const nextDead = (usersView as any)._dead ?? 0;
          renderMutator(
            nextLen <= prevLen
              ? `row[${i}].name overwritten in-place (0 allocs)`
              : nextDead === prevDead
                ? `row[${i}].name extended in-place at tail tip (0 dead bytes)`
                : `row[${i}].name bump-allocated in tail arena`
          );
        });

        const scoresInput = document.createElement('input');
        scoresInput.value = Array.from(u.scores).join(', ');
        scoresInput.title = 'Comma-separated u32 slice values';
        scoresInput.addEventListener('change', () => {
          const nums = scoresInput.value
            .split(',')
            .map((s) => parseInt(s.trim(), 10))
            .filter((n) => !Number.isNaN(n) && n >= 0);
          usersView.at(i).set({ scores: nums });
          renderMutator(`Updated row[${i}].scores (${nums.length} u32 items)`);
        });

        rowDiv.append(idSpan, nameInput, scoresInput);
        listEl.appendChild(rowDiv);
      }
    }
  }

  document.getElementById('cs-btn-push')?.addEventListener('click', () => {
    const id = nextId++;
    usersView.push({ id, name: `Engineer_${id}`, scores: [id * 10, id * 20] });
    renderMutator(`users.push({ id: ${id}, ... })`);
  });

  document.getElementById('cs-btn-pop')?.addEventListener('click', () => {
    const popped = usersView.pop();
    renderMutator(popped ? `users.pop() -> #${popped.id}` : 'users.pop() (empty)');
  });

  document.getElementById('cs-btn-compact')?.addEventListener('click', () => {
    const packed = usersView.compact();
    renderMutator(`users.compact() -> ${packed.byteLength} B tight wire buffer`);
  });

  renderMutator('Initial 2-row binary buffer');

  // --- TAB 3: RUST #[repr(C)] CODEGEN ---
  const OutHit = defineStruct('OutHit', {
    fid: u32,
    lat: f64,
    lon: f64,
    tStart: f64,
    tEnd: f64,
    fids: fixedArray(u32, 8),
  });

  const PaddedAlignment = defineStruct('PaddedAlignment', {
    big: u64,
    flag: u8,
    code: u16,
    samples: slice(i32),
  });
  const GraphNode: any = defineStruct('GraphNode', {
    id: u32,
    weight: f64,
    label: str,
    next: ref(() => GraphNode),
    children: slice(() => GraphNode),
  });

  const presets: Record<string, { ts: string; structs: any[] }> = {
    telemetry: {
      ts: `const Waypoint = defineStruct('Waypoint', {
  lat: f32, // offset 0, size 4
  lon: f32, // offset 4, size 4
}); // size: 8, align: 4

const TelemetryRow = defineStruct('TelemetryRow', {
  flightId: u32,                // offset 0
  squawk: u16,                  // offset 4
  flags: u16,                   // offset 6
  lat: f32,                     // offset 8
  lon: f32,                     // offset 12
  altBaro: i32,                 // offset 16
  groundSpeed: f32,             // offset 20
  callsign: str,                // offset 24 ([u32 relOffset, u32 len])
  route: str,                   // offset 32 ([u32 relOffset, u32 len])
  waypoints: slice(Waypoint),   // offset 40 ([u32 relOffset, u32 len])
}); // size: 48, align: 4`,
      structs: [Waypoint, TelemetryRow],
    },
    graph: {
      ts: `const GraphNode: any = defineStruct('GraphNode', {
  id: u32,                           // offset 0, size 4 (+4B padding before f64)
  weight: f64,                       // offset 8, size 8
  label: str,                        // offset 16, size 8 (CapnStr)
  next: ref(() => GraphNode),        // offset 24, size 8 (CapnRef<GraphNode>)
  children: slice(() => GraphNode),  // offset 32, size 8 (CapnSlice<GraphNode>)
}); // size: 40, align: 8`,
      structs: [GraphNode],
    },
    spdsample: {
      ts: `const SpdSample = defineStruct('SpdSample', {
  t: u32,    // offset 0 (4B padding auto-inserted after t)
  val: f64,  // offset 8, align 8
  id: u32,   // offset 16 (4B trailing padding to align stride to 8)
}); // size: 24, align: 8

const OutHit = defineStruct('OutHit', {
  fid: u32,                  // offset 0 (4B padding before lat)
  lat: f64,                  // offset 8
  lon: f64,                  // offset 16
  tstart: f64,               // offset 24
  tend: f64,                 // offset 32
  fids: fixedArray(u32, 8),  // offset 40..72
}); // size: 72, align: 8`,
      structs: [SpdSample, OutHit],
    },
    padded: {
      ts: `const PaddedAlignment = defineStruct('PaddedAlignment', {
  big: u64,            // offset 0, align 8
  flag: u8,            // offset 8, align 1 (+1B pad before code)
  code: u16,           // offset 10, align 2
  samples: slice(i32), // offset 12, align 4 (8B CapnSlice<i32> + 4B tail pad)
}); // size: 24, align: 8`,
      structs: [PaddedAlignment],
    },
  };

  const selectEl = document.getElementById('cs-schema-select') as HTMLSelectElement | null;
  const targetEl = document.getElementById('cs-target-select') as HTMLSelectElement | null;
  const labelEl = document.getElementById('cs-codegen-label');
  function renderRustCodegen() {
    const key = selectEl?.value ?? 'telemetry';
    const target = targetEl?.value ?? 'rust';
    const preset = presets[key] ?? presets.telemetry;
    const tsEl = document.getElementById('cs-ts-schema');
    const rsEl = document.getElementById('cs-rust-output');
    if (tsEl) tsEl.textContent = preset.ts;
    if (labelEl) {
      labelEl.innerHTML =
        target === 'go-wasm'
          ? 'Generated Go / TinyGo WASM <code>toGoStruct([...], { wasm: true })</code> Output:'
          : target === 'go'
            ? 'Generated Go <code>toGoStruct([...])</code> Output:'
            : 'Generated Rust <code>toRustReprC([...])</code> Output:';
    }
    if (rsEl) {
      rsEl.textContent =
        target === 'go-wasm'
          ? toGoStruct(preset.structs, { wasm: true })
          : target === 'go'
            ? toGoStruct(preset.structs)
            : toRustReprC(preset.structs);
    }
  }
  selectEl?.addEventListener('change', renderRustCodegen);
  targetEl?.addEventListener('change', renderRustCodegen);
  renderRustCodegen();
</script>
