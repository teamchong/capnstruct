---
---

<div class="cs-playground not-content">
  <div class="cs-tabs" role="tablist">
    <button class="cs-tab active" data-tab="bench" role="tab" aria-selected="true">
      1. Live 60 FPS Visual Proof &amp; Scaling Graphs
    </button>
    <button class="cs-tab" data-tab="mutate" role="tab" aria-selected="false">
      2. Binary Inspector &amp; Live Mutator
    </button>
    <button class="cs-tab" data-tab="rust" role="tab" aria-selected="false">
      3. Rust #[repr(C)] Codegen
    </button>
  </div>

  <!-- TAB 1: LIVE 60FPS VISUAL SIMULATOR + SCALING GRAPHS -->
  <div class="cs-panel active" id="cs-panel-bench">
    <div class="cs-panel-header">
      <div>
        <strong>Why Restructuring Data Layout Beats Switching JS Engines (Live 60 FPS Proof)</strong>
        <p class="cs-sub">
          Move your cursor over the radar to query &amp; mutate live telemetry nodes and cyclic <code>ref(() =&gt; RingNode)</code> graphs every frame. Switch between <strong>capnstruct Zero-Copy</strong>, <strong>Engine Switch Sim (JSC ~2x)</strong>, and <strong>Plain JS Wire/Worker (JSON / structuredClone)</strong> to feel the frame-time and GC difference live.
        </p>
      </div>
      <div class="cs-sim-controls">
        <div class="cs-mode-group" role="group" aria-label="Layout Mode">
          <button class="cs-mode-btn active" data-mode="capn">⚡ capnstruct #[repr(C)] (0 MB)</button>
          <button class="cs-mode-btn" data-mode="jsc">🟠 Engine Switch Sim (In-Mem / JSC)</button>
          <button class="cs-mode-btn" data-mode="json">🔴 Plain JS Wire/Worker (JSON / Clone)</button>
        </div>
      </div>
    </div>

    <!-- Interactive Parameter Bar (Anti-Cherry-Pick Controls) -->
    <div class="cs-param-bar">
      <div class="cs-param-item">
        <span class="cs-param-label">Dataset Scale (N):</span>
        <div class="cs-pill-group" id="cs-scale-group">
          <button class="cs-mini-btn" data-scale="2500">2.5k</button>
          <button class="cs-mini-btn" data-scale="10000">10k</button>
          <button class="cs-mini-btn active" data-scale="25000">25k</button>
          <button class="cs-mini-btn" data-scale="50000">50k</button>
        </div>
      </div>
      <div class="cs-param-item">
        <label class="cs-param-label" for="cs-sel-slider"> Radar Filter Hit Rate (Strings Decoded): <strong id="cs-sel-val">4%</strong></label>
        <input id="cs-sel-slider" type="range" min="1" max="100" value="4" class="cs-slider" />
      </div>
      <div class="cs-param-item cs-live-hud">
        <span class="cs-hud-badge cs-hud-fps" id="cs-hud-fps">60 FPS</span>
        <span class="cs-hud-badge" id="cs-hud-ms">0.18 ms/frame</span>
        <span class="cs-hud-badge" id="cs-hud-heap">0.00 MB heap/s</span>
      </div>
    </div>

    <!-- Dual Live Canvas: Spatial Radar + Real-Time Frame Budget Oscilloscope -->
    <div class="cs-canvas-grid">
      <div class="cs-canvas-wrap">
        <div class="cs-canvas-title">
          <span>Live Spatial Telemetry + Cyclic <code>ref(() =&gt; Node)</code> Ring Graph</span>
          <span class="cs-canvas-hint" id="cs-canvas-matched">Hover/drag radar lens</span>
        </div>
        <canvas id="cs-radar-canvas" width="520" height="250"></canvas>
      </div>
      <div class="cs-canvas-wrap">
        <div class="cs-canvas-title">
          <span>Real-Time Frame Budget Graph (ms/frame vs 60/120 FPS Limit)</span>
          <span class="cs-canvas-hint" id="cs-osc-status">Well below 8.3ms (120 FPS)</span>
        </div>
        <canvas id="cs-osc-canvas" width="420" height="250"></canvas>
      </div>
    </div>

    <!-- VISUAL MULTI-CURVE GRAPHS (Not Cherry-Picked: Scale Sweep + Selectivity Sweep + Live Browser Runner) -->
    <div class="cs-graph-section">
      <div class="cs-graph-header">
        <div class="cs-graph-tabs" role="tablist">
          <button class="cs-gtab active" data-gtab="scale">📈 Graph 1: Scaling Curve (N = 100 → 100k)</button>
          <button class="cs-gtab" data-gtab="selectivity">🎯 Graph 2: Filter Selectivity (0.5% → 100% Decode)</button>
          <button class="cs-gtab" data-gtab="livebars">⚡ Graph 3: Run Live in Your Browser</button>
        </div>
        <button id="cs-run-bench" class="cs-btn cs-btn-primary">▶ Run Live Browser Benchmark</button>
      </div>

      <!-- GRAPH 1: SCALING CURVE SVG (N = 100 -> 100,000) -->
      <div class="cs-gpanel active" id="cs-gpanel-scale">
        <div class="cs-graph-card">
          <div class="cs-graph-legend">
            <span class="cs-leg-item"><i class="cs-dot cs-dot-v8"></i> Node.js v24 (V8) Plain JS / Clone</span>
            <span class="cs-leg-item"><i class="cs-dot cs-dot-jsc"></i> Bun v1.4 (JavaScriptCore) Engine Switch</span>
            <span class="cs-leg-item"><i class="cs-dot cs-dot-capn"></i> <strong>capnstruct #[repr(C)] Binary Layout (0 MB Heap)</strong></span>
            <span class="cs-leg-item"><i class="cs-dot cs-dot-inmem"></i> Already-In-Memory JS Array (No Parse/Clone)</span>
          </div>
          <svg viewBox="0 0 860 270" class="cs-svg-chart" role="img" aria-label="Scaling curve comparing Node.js V8, Bun JSC, and capnstruct from N=100 to N=100,000 rows">
            <!-- Grid & Axes -->
            <line x1="70" y1="25" x2="820" y2="25" stroke="currentColor" stroke-opacity="0.08" />
            <line x1="70" y1="75" x2="820" y2="75" stroke="currentColor" stroke-opacity="0.08" />
            <line x1="70" y1="125" x2="820" y2="125" stroke="currentColor" stroke-opacity="0.08" />
            <line x1="70" y1="175" x2="820" y2="175" stroke="currentColor" stroke-opacity="0.08" />
            <line x1="70" y1="220" x2="820" y2="220" stroke="currentColor" stroke-opacity="0.25" />
            <line x1="70" y1="25" x2="70" y2="220" stroke="currentColor" stroke-opacity="0.25" />

            <!-- 16.6ms (60 FPS) & 8.3ms (120 FPS) Frame Budget Threshold Lines -->
            <line x1="70" y1="104" x2="820" y2="104" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="6,4" stroke-opacity="0.75" />
            <text x="815" y="98" text-anchor="end" font-size="11" fill="#ef4444" font-weight="600">16.6 ms — 60 FPS Frame Budget Ceiling (Stutter Zone Above)</text>
            <line x1="70" y1="162" x2="820" y2="162" stroke="#f59e0b" stroke-width="1.2" stroke-dasharray="4,4" stroke-opacity="0.65" />
            <text x="815" y="156" text-anchor="end" font-size="10.5" fill="#f59e0b">8.3 ms — 120 FPS Frame Budget</text>

            <!-- Y-Axis Labels (0 ms to 28 ms) -->
            <text x="62" y="29" text-anchor="end" font-size="11" fill="currentColor" opacity="0.7">28 ms</text>
            <text x="62" y="79" text-anchor="end" font-size="11" fill="currentColor" opacity="0.7">21 ms</text>
            <text x="62" y="129" text-anchor="end" font-size="11" fill="currentColor" opacity="0.7">14 ms</text>
            <text x="62" y="179" text-anchor="end" font-size="11" fill="currentColor" opacity="0.7">7 ms</text>
            <text x="62" y="224" text-anchor="end" font-size="11" fill="currentColor" opacity="0.7">0 ms</text>

            <!-- X-Axis Scale Points: N = 100, 1k, 5k, 10k, 25k, 50k, 100k -->
            <text x="90" y="242" text-anchor="middle" font-size="11" fill="currentColor" opacity="0.8">N=100</text>
            <text x="205" y="242" text-anchor="middle" font-size="11" fill="currentColor" opacity="0.8">1,000</text>
            <text x="320" y="242" text-anchor="middle" font-size="11" fill="currentColor" opacity="0.8">5,000</text>
            <text x="435" y="242" text-anchor="middle" font-size="11" fill="currentColor" opacity="0.8">10,000</text>
            <text x="550" y="242" text-anchor="middle" font-size="11" fill="currentColor" opacity="0.8">25,000</text>
            <text x="665" y="242" text-anchor="middle" font-size="11" fill="currentColor" opacity="0.8">50,000</text>
            <text x="785" y="242" text-anchor="middle" font-size="11" fill="currentColor" opacity="0.8">100,000</text>

            <!-- Shaded Gap Between Engine Switch (JSC) and Data Layout Change (capnstruct) -->
            <polygon points="90,219.7 205,219 320,215.7 435,211 550,197 665,173.3 785,123 785,219 665,219 550,219.6 435,219.9 320,219.9 205,219.9 90,219.9" fill="#10b981" fill-opacity="0.09" />

            <!-- Curve 1: Node.js v24 (V8) structuredClone / Wire Parse (0.034 -> 0.26 -> 1.27 -> 2.58 -> 6.60 -> 13.79 -> 27.85 ms) -->
            <polyline fill="none" stroke="#ef4444" stroke-width="3" points="90,219.7 205,218.2 320,211.1 435,202.0 550,173.8 665,123.5 785,25.1" />
            <circle cx="90" cy="219.7" r="4" fill="#ef4444" /><circle cx="205" cy="218.2" r="4" fill="#ef4444" /><circle cx="320" cy="211.1" r="4" fill="#ef4444" /><circle cx="435" cy="202.0" r="4" fill="#ef4444" /><circle cx="550" cy="173.8" r="4" fill="#ef4444" /><circle cx="665" cy="123.5" r="4" fill="#ef4444" /><circle cx="785" cy="25.1" r="5" fill="#ef4444" />
            <text x="772" y="38" text-anchor="end" font-size="11" font-weight="700" fill="#ef4444">Node V8: 27.8 ms (+10.3 MB heap)</text>

            <!-- Curve 2: Bun v1.4 (JSC) Engine Switch (0.035 -> 0.14 -> 0.62 -> 1.28 -> 3.28 -> 6.68 -> 13.85 ms) -->
            <polyline fill="none" stroke="#f59e0b" stroke-width="3" points="90,219.7 205,219.0 320,215.7 435,211.0 550,197.0 665,173.3 785,123.0" />
            <circle cx="90" cy="219.7" r="4" fill="#f59e0b" /><circle cx="205" cy="219.0" r="4" fill="#f59e0b" /><circle cx="320" cy="215.7" r="4" fill="#f59e0b" /><circle cx="435" cy="211.0" r="4" fill="#f59e0b" /><circle cx="550" cy="197.0" r="4" fill="#f59e0b" /><circle cx="665" cy="173.3" r="4" fill="#f59e0b" /><circle cx="785" cy="123.0" r="5" fill="#f59e0b" />
            <text x="772" y="118" text-anchor="end" font-size="11" font-weight="700" fill="#f59e0b">Bun JSC: 13.9 ms (Only ~2x faster, still +6.4 MB heap)</text>

            <!-- Curve 4: Already-In-Memory Plain JS Loop (Dashed reference: 0.002 -> 0.12 ms) -->
            <polyline fill="none" stroke="#94a3b8" stroke-width="1.8" stroke-dasharray="3,3" points="90,219.9 205,219.9 320,219.9 435,219.9 550,219.7 665,218.8 785,219.1" />

            <!-- Curve 3: capnstruct #[repr(C)] Contiguous Layout (0.005 -> 0.018 -> 0.013 -> 0.015 -> 0.057 -> 0.15 -> 0.15 ms) -->
            <polyline fill="none" stroke="#10b981" stroke-width="3.5" points="90,219.9 205,219.9 320,219.9 435,219.9 550,219.6 665,219.0 785,218.9" />
            <circle cx="90" cy="219.9" r="4" fill="#10b981" /><circle cx="205" cy="219.9" r="4" fill="#10b981" /><circle cx="320" cy="219.9" r="4" fill="#10b981" /><circle cx="435" cy="219.9" r="4" fill="#10b981" /><circle cx="550" cy="219.6" r="4" fill="#10b981" /><circle cx="665" cy="219.0" r="4" fill="#10b981" /><circle cx="785" cy="218.9" r="5.5" fill="#10b981" />
            <text x="772" y="210" text-anchor="end" font-size="11.5" font-weight="800" fill="#10b981">capnstruct #[repr(C)]: 0.15 ms — 0.00 MB Heap (180x faster than V8, 90x faster than Bun)</text>

            <!-- Honest Callout at N=100 -->
            <text x="95" y="198" font-size="10" fill="currentColor" opacity="0.65">← At N≤100, all 3 meet (~0.02ms)</text>
          </svg>
          <p class="cs-graph-caption">
            <strong>Why this proves data layout beats switching engines:</strong> Switching from Node.js (V8) to Bun (JSC) only bends the slope by a constant ~2x because both engines still allocate and traverse <code>N</code> boxed heap objects. Restructuring into a contiguous <code>#[repr(C)]</code> binary layout flattens the curve along the bottom axis with <strong>0 MB heap allocation</strong>.
          </p>
        </div>
      </div>

      <!-- GRAPH 2: FILTER SELECTIVITY SWEEP SVG (0.5% -> 100% Hit Rate on 25,000 13-Field Telemetry Rows) -->
      <div class="cs-gpanel" id="cs-gpanel-selectivity">
        <div class="cs-graph-card">
          <div class="cs-graph-legend">
            <span class="cs-leg-item"><i class="cs-dot cs-dot-v8"></i> Node V8 (<code>JSON.parse</code> + filter)</span>
            <span class="cs-leg-item"><i class="cs-dot cs-dot-jsc"></i> Bun JSC (<code>JSON.parse</code> + filter)</span>
            <span class="cs-leg-item"><i class="cs-dot cs-dot-capn"></i> <strong>capnstruct Zero-Copy Filter + UTF-8 Decode</strong></span>
            <span class="cs-leg-item"><i class="cs-dot cs-dot-inmem"></i> Already-Parsed In-Memory JS Objects (No Wire Parse)</span>
          </div>
          <svg viewBox="0 0 860 260" class="cs-svg-chart" role="img" aria-label="Filter selectivity curve from 0.5% to 100% matched rows on 25,000 telemetry records">
            <line x1="70" y1="30" x2="820" y2="30" stroke="currentColor" stroke-opacity="0.08" />
            <line x1="70" y1="80" x2="820" y2="80" stroke="currentColor" stroke-opacity="0.08" />
            <line x1="70" y1="130" x2="820" y2="130" stroke="currentColor" stroke-opacity="0.08" />
            <line x1="70" y1="180" x2="820" y2="180" stroke="currentColor" stroke-opacity="0.08" />
            <line x1="70" y1="215" x2="820" y2="215" stroke="currentColor" stroke-opacity="0.25" />
            <line x1="70" y1="30" x2="70" y2="215" stroke="currentColor" stroke-opacity="0.25" />

            <text x="62" y="34" text-anchor="end" font-size="11" fill="currentColor" opacity="0.7">16 ms</text>
            <text x="62" y="84" text-anchor="end" font-size="11" fill="currentColor" opacity="0.7">12 ms</text>
            <text x="62" y="134" text-anchor="end" font-size="11" fill="currentColor" opacity="0.7">8 ms</text>
            <text x="62" y="184" text-anchor="end" font-size="11" fill="currentColor" opacity="0.7">4 ms</text>
            <text x="62" y="219" text-anchor="end" font-size="11" fill="currentColor" opacity="0.7">0 ms</text>

            <!-- X-Axis Selectivity Points: 0.5%, 5%, 25%, 50%, 100% of 25,000 rows -->
            <text x="110" y="238" text-anchor="middle" font-size="11" fill="currentColor" opacity="0.8">0.5% Hit (125 rows)</text>
            <text x="275" y="238" text-anchor="middle" font-size="11" fill="currentColor" opacity="0.8">5% Hit (1,250)</text>
            <text x="445" y="238" text-anchor="middle" font-size="11" fill="currentColor" opacity="0.8">25% Hit (6,250)</text>
            <text x="615" y="238" text-anchor="middle" font-size="11" fill="currentColor" opacity="0.8">50% Hit (12,500)</text>
            <text x="775" y="238" text-anchor="middle" font-size="11" fill="currentColor" opacity="0.8">100% Hit (All 25,000!)</text>

            <!-- Node V8 JSON.parse + filter: ~14.2-15.4 ms across all hit rates -->
            <polyline fill="none" stroke="#ef4444" stroke-width="3" points="110,36.5 275,55.3 445,46.6 615,51.2 775,51.2" />
            <circle cx="110" cy="36.5" r="4" fill="#ef4444" /><circle cx="275" cy="55.3" r="4" fill="#ef4444" /><circle cx="445" cy="46.6" r="4" fill="#ef4444" /><circle cx="615" cy="51.2" r="4" fill="#ef4444" /><circle cx="775" cy="51.2" r="5" fill="#ef4444" />
            <text x="770" y="42" text-anchor="end" font-size="11" font-weight="700" fill="#ef4444">Node V8 JSON.parse: ~14.2 ms everywhere (+8.2 MB heap)</text>

            <!-- Bun JSC JSON.parse + filter: ~5.6-6.3 ms across all hit rates -->
            <polyline fill="none" stroke="#f59e0b" stroke-width="3" points="110,141.9 275,143.8 445,150.2 615,149.7 775,148.7" />
            <circle cx="110" cy="141.9" r="4" fill="#f59e0b" /><circle cx="275" cy="143.8" r="4" fill="#f59e0b" /><circle cx="445" cy="150.2" r="4" fill="#f59e0b" /><circle cx="615" cy="149.7" r="4" fill="#f59e0b" /><circle cx="775" cy="148.7" r="5" fill="#f59e0b" />
            <text x="770" y="139" text-anchor="end" font-size="11" font-weight="700" fill="#f59e0b">Bun JSC JSON.parse: ~5.7 ms everywhere (+5.2 MB heap)</text>

            <!-- capnstruct Zero-Copy Filter + UTF-8 Decode: 0.34ms (0.5%) -> 0.38ms (5%) -> 0.67ms (25%) -> 0.70ms (50%) -> 1.19ms (100%) -->
            <polyline fill="none" stroke="#10b981" stroke-width="3.5" points="110,211.0 275,210.6 445,207.2 615,206.9 775,201.2" />
            <circle cx="110" cy="211.0" r="4.5" fill="#10b981" /><circle cx="275" cy="210.6" r="4.5" fill="#10b981" /><circle cx="445" cy="207.2" r="4.5" fill="#10b981" /><circle cx="615" cy="206.9" r="4.5" fill="#10b981" /><circle cx="775" cy="201.2" r="5.5" fill="#10b981" />
            <text x="770" y="193" text-anchor="end" font-size="11.5" font-weight="800" fill="#10b981">capnstruct: 0.34 ms (at 0.5%) → 1.19 ms (even at 100% decode!Still 12x vs V8 &amp; 6.5x vs Bun)</text>

            <!-- Already-Parsed In-Memory JS Objects (Dashed reference: ~0.08 ms) -->
            <polyline fill="none" stroke="#94a3b8" stroke-width="1.8" stroke-dasharray="3,3" points="110,214.0 275,214.4 445,214.1 615,214.3 775,214.2" />
          </svg>
          <p class="cs-graph-caption">
            <strong>Not cherry-picked at 0.4% selectivity:</strong> Even if your filter matches <strong>100% of all 25,000 rows</strong> and decodes every single UTF-8 <code>callsign</code> string on the fly, <code>capnstruct</code> (<strong>1.19 ms on V8 / 0.88 ms on Bun</strong>) still beats <code>JSON.parse</code> by <strong>6.5x–12x with 0 MB struct heap</strong>. (And if data is already parsed in local JS memory with no wire/Worker boundary, the dashed grey line shows plain JS objects take ~0.08 ms.)
          </p>
        </div>
      </div>

      <!-- GRAPH 3: LIVE BROWSER BENCHMARK BARS -->
      <div class="cs-gpanel" id="cs-gpanel-livebars">
        <div id="cs-bench-results" class="cs-bench-grid">
          <div class="cs-bench-card" data-bench="scan">
            <div class="cs-bench-top">
              <div class="cs-bench-title">1. 100,000 Numeric Struct Scan (2.29 MiB)</div>
              <div class="cs-bench-desc">Flyweight cursor (<strong>0.00 MB heap</strong>) vs <code>JSON.parse</code> + loop (<strong>+10.33 MB V8 / +6.38 MB Bun</strong>)</div>
            </div>
            <div class="cs-bench-bottom">
              <div class="cs-bars">
                <div class="cs-bar-row">
                  <span class="cs-bar-label">JSON.parse + loop (+10.3 MB)</span>
                  <div class="cs-bar-track"><div class="cs-bar-fill cs-bar-json" style="width: 100%"></div></div>
                  <span class="cs-bar-val" id="cs-b1-json">13.51 ms</span>
                </div>
                <div class="cs-bar-row">
                  <span class="cs-bar-label">capnstruct for..of (0 MB)</span>
                  <div class="cs-bar-track"><div class="cs-bar-fill cs-bar-capn" id="cs-b1-bar" style="width: 4%"></div></div>
                  <span class="cs-bar-val" id="cs-b1-capn">0.62 ms</span>
                </div>
              </div>
              <div class="cs-speedup" id="cs-b1-speedup">21.6x faster (Click "Run Live Browser Benchmark" to test your device)</div>
            </div>
          </div>
          <div class="cs-bench-card" data-bench="bbox">
            <div class="cs-bench-top">
              <div class="cs-bench-title">2. 25,000 Flight Telemetry Rows (13 Fields)</div>
              <div class="cs-bench-desc">Sparse BBox filter + lazy UTF-8 decode (<strong>0.00 MB heap</strong> vs <strong>+8.18 MB V8 / +5.21 MB Bun</strong>)</div>
            </div>
            <div class="cs-bench-bottom">
              <div class="cs-bars">
                <div class="cs-bar-row">
                  <span class="cs-bar-label">JSON.parse + filter (+8.2 MB)</span>
                  <div class="cs-bar-track"><div class="cs-bar-fill cs-bar-json" style="width: 100%"></div></div>
                  <span class="cs-bar-val" id="cs-b2-json">12.82 ms</span>
                </div>
                <div class="cs-bar-row">
                  <span class="cs-bar-label">capnstruct zero-copy (0 MB)</span>
                  <div class="cs-bar-track"><div class="cs-bar-fill cs-bar-capn" id="cs-b2-bar" style="width: 3%"></div></div>
                  <span class="cs-bar-val" id="cs-b2-capn">0.29 ms</span>
                </div>
              </div>
              <div class="cs-speedup" id="cs-b2-speedup">44.2x faster (0 MB heap)</div>
            </div>
          </div>
          <div class="cs-bench-card" data-bench="mutate">
            <div class="cs-bench-top">
              <div class="cs-bench-title">3. Web Worker Round-Trip + Update (25,000 Rows)</div>
              <div class="cs-bench-desc"><code>structuredClone</code> round-trip (<strong>+14.24 MB V8 / +5.73 MB Bun</strong>) vs shared buffer in-place (<strong>0.00 MB</strong>)</div>
            </div>
            <div class="cs-bench-bottom">
              <div class="cs-bars">
                <div class="cs-bar-row">
                  <span class="cs-bar-label">structuredClone RT (+14.2 MB)</span>
                  <div class="cs-bar-track"><div class="cs-bar-fill cs-bar-json" style="width: 100%"></div></div>
                  <span class="cs-bar-val" id="cs-b3-json">45.00 ms</span>
                </div>
                <div class="cs-bar-row">
                  <span class="cs-bar-label">capnstruct in-place (0 MB)</span>
                  <div class="cs-bar-track"><div class="cs-bar-fill cs-bar-capn" id="cs-b3-bar" style="width: 1%"></div></div>
                  <span class="cs-bar-val" id="cs-b3-capn">0.05 ms</span>
                </div>
              </div>
              <div class="cs-speedup" id="cs-b3-speedup">829x faster (0 MB heap vs +14.2 MB)</div>
            </div>
          </div>
          <div class="cs-bench-card" data-bench="col">
            <div class="cs-bench-top">
              <div class="cs-bench-title">4. 10,000 Cyclic Ring Nodes (<code>ref(() =&gt; RingNode)</code>)</div>
              <div class="cs-bench-desc"><code>JSON.stringify</code> throws <code>TypeError</code>! Compare <code>structuredClone</code> (<strong>+1.76 MB</strong>) vs <code>ref()</code> (<strong>0.00 MB</strong>)</div>
            </div>
            <div class="cs-bench-bottom">
              <div class="cs-bars">
                <div class="cs-bar-row">
                  <span class="cs-bar-label">structuredClone (+1.8 MB)</span>
                  <div class="cs-bar-track"><div class="cs-bar-fill cs-bar-json" style="width: 100%"></div></div>
