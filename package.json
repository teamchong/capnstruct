{
  "name": "capnstruct",
  "version": "0.1.0",
  "description": "Zero-dependency declarative #[repr(C)] flat memory structs, zero-copy views, and WebAssembly.Memory arena for JS/TS and Rust WASM.",
  "license": "MIT",
  "homepage": "https://capnstruct.teamchong.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teamchong/capnstruct.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "capnstruct": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./codegen": {
      "types": "./dist/codegen.d.ts",
      "default": "./dist/codegen.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "node --import ./dist/index.js test/bench.js",
    "size": "node scripts/check-size.mjs",
    "docs:dev": "pnpm --filter capnstruct-docs dev",
    "docs:build": "pnpm run build && pnpm --filter capnstruct-docs build"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
